 205:User/GUI_App/Screens/Src/ui_ComputerPage.c ****             return;
 206:User/GUI_App/Screens/Src/ui_ComputerPage.c ****         }
 207:User/GUI_App/Screens/Src/ui_ComputerPage.c **** 
 208:User/GUI_App/Screens/Src/ui_ComputerPage.c ****         if(CalStr.Top_Point < TEXT_FULL) {
 209:User/GUI_App/Screens/Src/ui_ComputerPage.c ****             lv_textarea_add_text(ui_CompageTextarea, txt);
 210:User/GUI_App/Screens/Src/ui_ComputerPage.c ****             strput(&CalStr, stack_char);
 211:User/GUI_App/Screens/Src/ui_ComputerPage.c ****         }
 212:User/GUI_App/Screens/Src/ui_ComputerPage.c ****     }
