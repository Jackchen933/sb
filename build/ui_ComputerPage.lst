 215:User/GUI_App/Screens/Src/ui_ComputerPage.c **** void ui_CompageBackBtn_event_cb(lv_event_t * e)
 216:User/GUI_App/Screens/Src/ui_ComputerPage.c **** {
 217:User/GUI_App/Screens/Src/ui_ComputerPage.c ****     lv_event_code_t code = lv_event_get_code(e);
