 295:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *        8 bit red LSB = (2^5 - 1) / (2^3 - 1) = 31 / 7 = 4
 296:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *
 297:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  * - When calculating to smaller color type simply shift out the LSBs
 298:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *   E.g.  8 bit Red has 3 bits
 299:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *        16 bit Red has 5 bits
 300:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *        ----------------------
 301:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *         Shift right with 5 - 3 = 2
 302:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  */
 303:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** static inline uint8_t lv_color_to1(lv_color_t color)
