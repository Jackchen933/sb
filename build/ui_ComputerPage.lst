 191:User/GUI_App/Screens/Src/ui_ComputerPage.c **** 
 192:User/GUI_App/Screens/Src/ui_ComputerPage.c ****     if(code == LV_EVENT_VALUE_CHANGED) {
 193:User/GUI_App/Screens/Src/ui_ComputerPage.c ****         uint16_t btn_id = lv_btnmatrix_get_selected_btn(obj);
 194:User/GUI_App/Screens/Src/ui_ComputerPage.c ****         const char * txt = lv_btnmatrix_get_btn_text(obj, btn_id);
 195:User/GUI_App/Screens/Src/ui_ComputerPage.c ****         char stack_char = btn_id_to_stack_char(btn_id);
 196:User/GUI_App/Screens/Src/ui_ComputerPage.c **** 
 197:User/GUI_App/Screens/Src/ui_ComputerPage.c ****         if(txt == NULL || ui_CompageTextarea == NULL || stack_char == 0) {
