 190:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** 
 191:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     if(data_p == &zero_mem) return lv_mem_alloc(new_size);
 192:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** 
 193:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** #if LV_MEM_CUSTOM == 0
 194:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     void * new_p = lv_tlsf_realloc(tlsf, data_p, new_size);
 195:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** #else
 196:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     void * new_p = LV_MEM_CUSTOM_REALLOC(data_p, new_size);
 197:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** #endif
 198:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     if(new_p == NULL) {
