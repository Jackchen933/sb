 229:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** /**
 230:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****  * Give information about the work memory of dynamic allocation
 231:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****  * @param mon_p pointer to a lv_mem_monitor_t variable,
 232:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****  *              the result of the analysis will be stored here
 233:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****  */
 234:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** void lv_mem_monitor(lv_mem_monitor_t * mon_p)
 235:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** {
 236:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     /*Init the data*/
 237:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     lv_memset(mon_p, 0, sizeof(lv_mem_monitor_t));
 238:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** #if LV_MEM_CUSTOM == 0
 239:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     MEM_TRACE("begin");
 240:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** 
 241:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     lv_tlsf_walk_pool(lv_tlsf_get_pool(tlsf), lv_mem_walker, mon_p);
 242:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** 
 243:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     mon_p->total_size = LV_MEM_SIZE;
 244:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     mon_p->used_pct = 100 - (100U * mon_p->free_size) / mon_p->total_size;
 245:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     if(mon_p->free_size > 0) {
 246:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****         mon_p->frag_pct = mon_p->free_biggest_size * 100U / mon_p->free_size;
 247:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****         mon_p->frag_pct = 100 - mon_p->frag_pct;
 248:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     }
 249:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     else {
 250:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****         mon_p->frag_pct = 0; /*no fragmentation if all the RAM is used*/
 251:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     }
 252:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** 
 253:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     MEM_TRACE("finished");
 254:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** #endif
 255:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** }
