 284:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     }
 285:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** 
 286:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     if(i_guess >= 0) {
 287:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****         LV_GC_ROOT(lv_mem_buf[i_guess]).used = 1;
 288:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****         MEM_TRACE("returning already allocated buffer (buffer id: %d, address: %p)", i_guess,
 289:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****                   LV_GC_ROOT(lv_mem_buf[i_guess]).p);
