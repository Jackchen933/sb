 183:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c **** {
 184:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     MEM_TRACE("reallocating %p with %lu size", data_p, (unsigned long)new_size);
 185:Middlewares/LVGL/GUI/lvgl/src/misc/lv_mem.c ****     if(new_size == 0) {
