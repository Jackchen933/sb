 157:BSP/LCD/lcd.c **** 
 158:BSP/LCD/lcd.c **** /******************************************************************************
 159:BSP/LCD/lcd.c ****       函数说明：显示汉字串
 160:BSP/LCD/lcd.c ****       入口数据：x,y显示坐标
 161:BSP/LCD/lcd.c ****                 *s 要显示的汉字串
 162:BSP/LCD/lcd.c ****                 fc 字的颜色
 163:BSP/LCD/lcd.c ****                 bc 字的背景色
 164:BSP/LCD/lcd.c ****                 sizey 字号 可选 16 24 32
 165:BSP/LCD/lcd.c ****                 mode:  0非叠加模式  1叠加模式
 166:BSP/LCD/lcd.c ****       返回值：  无
 167:BSP/LCD/lcd.c **** ******************************************************************************/
 168:BSP/LCD/lcd.c **** void LCD_ShowChinese(u16 x,u16 y,u8 *s,u16 fc,u16 bc,u8 sizey,u8 mode)
 169:BSP/LCD/lcd.c **** {
 170:BSP/LCD/lcd.c **** 	while(*s!=0)
 171:BSP/LCD/lcd.c **** 	{
 172:BSP/LCD/lcd.c **** 		if(sizey==12) LCD_ShowChinese12x12(x,y,s,fc,bc,sizey,mode);
 173:BSP/LCD/lcd.c **** 		else if(sizey==16) LCD_ShowChinese16x16(x,y,s,fc,bc,sizey,mode);
 174:BSP/LCD/lcd.c **** 		else if(sizey==24) LCD_ShowChinese24x24(x,y,s,fc,bc,sizey,mode);
 175:BSP/LCD/lcd.c **** 		else if(sizey==32) LCD_ShowChinese32x32(x,y,s,fc,bc,sizey,mode);
 176:BSP/LCD/lcd.c **** 		else return;
 177:BSP/LCD/lcd.c **** 		s+=2;
 178:BSP/LCD/lcd.c **** 		x+=sizey;
 179:BSP/LCD/lcd.c **** 	}
 180:BSP/LCD/lcd.c **** }
 181:BSP/LCD/lcd.c **** 
