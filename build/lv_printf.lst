 142:Middlewares/LVGL/GUI/lvgl/src/misc/lv_printf.c **** // \return The length of the string (excluding the terminating 0) limited by 'maxsize'
 143:Middlewares/LVGL/GUI/lvgl/src/misc/lv_printf.c **** static inline unsigned int _strnlen_s(const char * str, size_t maxsize)
 144:Middlewares/LVGL/GUI/lvgl/src/misc/lv_printf.c **** {
 145:Middlewares/LVGL/GUI/lvgl/src/misc/lv_printf.c ****     const char * s;
