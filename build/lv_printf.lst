 150:Middlewares/LVGL/GUI/lvgl/src/misc/lv_printf.c **** // internal test if char is a digit (0-9)
 151:Middlewares/LVGL/GUI/lvgl/src/misc/lv_printf.c **** // \return true if char is a digit
