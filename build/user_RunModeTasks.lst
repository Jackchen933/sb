 130:User/Tasks/Src/user_RunModeTasks.c **** 			{
 131:User/Tasks/Src/user_RunModeTasks.c **** 				uint8_t hor;
 132:User/Tasks/Src/user_RunModeTasks.c **** 				hor = MPU_isHorizontal();
