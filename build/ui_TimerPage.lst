 418:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       4          64     48        3       255
 419:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       5         129     33        1       255
 420:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       6         259      3        0       255
 421:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      */
 422:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** 
 423:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     lv_color32_t ret;
