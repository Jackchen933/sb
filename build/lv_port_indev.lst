  49:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     /**
  50:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      * Here you will find example implementation of input devices supported by LittelvGL:
  51:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      *  - Touchpad
  52:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      *  - Mouse (with cursor support)
  53:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      *  - Keypad (supports GUI usage only with key)
  54:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      *  - Encoder (supports GUI usage only with: left, right, push)
  55:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      *  - Button (external buttons to press points on the screen)
  56:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      *
  57:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      *  The `..._read()` function are only examples.
  58:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      *  You should shape them according to your hardware
  59:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      */
  60:Middlewares/LVGL/GUI/porting/lv_port_indev.c **** 	 
  61:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     static lv_indev_drv_t indev_drv;
  62:Middlewares/LVGL/GUI/porting/lv_port_indev.c **** 
  63:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     /*------------------
  64:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      * Touchpad
  65:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****      * -----------------*/
  66:Middlewares/LVGL/GUI/porting/lv_port_indev.c **** 
  67:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     /*Initialize your touchpad if you have*/
  68:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     touchpad_init();
  69:Middlewares/LVGL/GUI/porting/lv_port_indev.c **** 
  70:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     /*Register a touchpad input device*/
  71:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     lv_indev_drv_init(&indev_drv);
  72:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     indev_drv.type = LV_INDEV_TYPE_POINTER;
  73:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     indev_drv.read_cb = touchpad_read;
  74:Middlewares/LVGL/GUI/porting/lv_port_indev.c ****     indev_touchpad = lv_indev_drv_register(&indev_drv);
  75:Middlewares/LVGL/GUI/porting/lv_port_indev.c **** 
