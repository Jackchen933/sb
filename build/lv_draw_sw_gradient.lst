 331:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** static inline uint8_t lv_color_to8(lv_color_t color)
 332:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** {
 333:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** #if LV_COLOR_DEPTH == 1
 334:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     if(color.full == 0)
 335:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****         return 0;
 336:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     else
 337:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****         return 0xFF;
 338:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** #elif LV_COLOR_DEPTH == 8
