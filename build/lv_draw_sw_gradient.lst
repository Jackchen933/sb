 340:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** #elif LV_COLOR_DEPTH == 16
 341:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     lv_color8_t ret;
 342:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     LV_COLOR_SET_R8(ret, LV_COLOR_GET_R(color) >> 2); /*5 - 3  = 2*/
 343:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     LV_COLOR_SET_G8(ret, LV_COLOR_GET_G(color) >> 3); /*6 - 3  = 3*/
 344:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     LV_COLOR_SET_B8(ret, LV_COLOR_GET_B(color) >> 3); /*5 - 2  = 3*/
 345:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     return ret.full;
 346:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** #elif LV_COLOR_DEPTH == 32
 347:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     lv_color8_t ret;
 348:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     LV_COLOR_SET_R8(ret, LV_COLOR_GET_R(color) >> 5); /*8 - 3  = 5*/
 349:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     LV_COLOR_SET_G8(ret, LV_COLOR_GET_G(color) >> 5); /*8 - 3  = 5*/
 350:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     LV_COLOR_SET_B8(ret, LV_COLOR_GET_B(color) >> 6); /*8 - 2  = 6*/
 351:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     return ret.full;
 352:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** #endif
 353:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** }
 354:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** 
 355:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** static inline uint16_t lv_color_to16(lv_color_t color)
 356:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** {
 357:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h **** #if LV_COLOR_DEPTH == 1
 358:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     if(color.full == 0)
 359:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****         return 0;
 360:Middlewares/LVGL/GUI/lvgl/src/draw/sw/../../misc/lv_color.h ****     else
