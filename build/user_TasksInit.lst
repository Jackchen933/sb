 185:User/Tasks/Src/user_TasksInit.c **** 	ScrRenewTaskHandle   = osThreadNew(ScrRenewTask, NULL, &ScrRenewTask_attributes);
 186:User/Tasks/Src/user_TasksInit.c **** 	SensorDataTaskHandle = osThreadNew(SensorDataUpdateTask, NULL, &SensorDataTask_attributes);
 187:User/Tasks/Src/user_TasksInit.c **** 	HRDataTaskHandle		 = osThreadNew(HRDataUpdateTask, NULL, &HRDataTask_attributes);
 188:User/Tasks/Src/user_TasksInit.c **** 	ChargPageEnterTaskHandle = osThreadNew(ChargPageEnterTask, NULL, &ChargPageEnterTask_attributes);
