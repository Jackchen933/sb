 203:User/Tasks/Src/user_TasksInit.c **** /**
 204:User/Tasks/Src/user_TasksInit.c ****   * @brief  FreeRTOS Tick Hook, to increase the LVGL tick
 205:User/Tasks/Src/user_TasksInit.c ****   * @param  None
 206:User/Tasks/Src/user_TasksInit.c ****   * @retval None
 207:User/Tasks/Src/user_TasksInit.c ****   */
 208:User/Tasks/Src/user_TasksInit.c **** void TaskTickHook(void)
 209:User/Tasks/Src/user_TasksInit.c **** {
 210:User/Tasks/Src/user_TasksInit.c **** 	//to increase the LVGL tick
 211:User/Tasks/Src/user_TasksInit.c **** 	lv_tick_inc(1);
 212:User/Tasks/Src/user_TasksInit.c **** 	//to increase the timerpage's timer(put in here is to ensure the Real Time)
 213:User/Tasks/Src/user_TasksInit.c **** 	if(ui_TimerPageFlag)
 214:User/Tasks/Src/user_TasksInit.c **** 	{
 215:User/Tasks/Src/user_TasksInit.c **** 			ui_TimerPage_ms+=1;
 216:User/Tasks/Src/user_TasksInit.c **** 			if(ui_TimerPage_ms>=10)
 217:User/Tasks/Src/user_TasksInit.c **** 			{
 218:User/Tasks/Src/user_TasksInit.c **** 				ui_TimerPage_ms=0;
 219:User/Tasks/Src/user_TasksInit.c **** 				// 递减逻辑
 220:User/Tasks/Src/user_TasksInit.c **** 				if(ui_TimerPage_10ms > 0)
 221:User/Tasks/Src/user_TasksInit.c **** 				{
 222:User/Tasks/Src/user_TasksInit.c **** 					ui_TimerPage_10ms-=1;
 223:User/Tasks/Src/user_TasksInit.c **** 				}
 224:User/Tasks/Src/user_TasksInit.c **** 				else
 225:User/Tasks/Src/user_TasksInit.c **** 				{
 226:User/Tasks/Src/user_TasksInit.c **** 					ui_TimerPage_10ms=99;
 227:User/Tasks/Src/user_TasksInit.c **** 					// 秒递减
 228:User/Tasks/Src/user_TasksInit.c **** 					if(ui_TimerPage_sec > 0)
 229:User/Tasks/Src/user_TasksInit.c **** 					{
 230:User/Tasks/Src/user_TasksInit.c **** 						ui_TimerPage_sec-=1;
 231:User/Tasks/Src/user_TasksInit.c **** 					}
 232:User/Tasks/Src/user_TasksInit.c **** 					else
 233:User/Tasks/Src/user_TasksInit.c **** 					{
 234:User/Tasks/Src/user_TasksInit.c **** 						ui_TimerPage_sec=59;
 235:User/Tasks/Src/user_TasksInit.c **** 						// 分递减
 236:User/Tasks/Src/user_TasksInit.c **** 						if(ui_TimerPage_min > 0)
 237:User/Tasks/Src/user_TasksInit.c **** 						{
 238:User/Tasks/Src/user_TasksInit.c **** 							ui_TimerPage_min-=1;
 239:User/Tasks/Src/user_TasksInit.c **** 						}
 240:User/Tasks/Src/user_TasksInit.c **** 						else
 241:User/Tasks/Src/user_TasksInit.c **** 						{
 242:User/Tasks/Src/user_TasksInit.c **** 							// 已经减到00:00.00了，停止！
 243:User/Tasks/Src/user_TasksInit.c **** 							ui_TimerPageFlag = 0;
 244:User/Tasks/Src/user_TasksInit.c **** 						}
 245:User/Tasks/Src/user_TasksInit.c **** 					}
 246:User/Tasks/Src/user_TasksInit.c **** 				}
 247:User/Tasks/Src/user_TasksInit.c **** 			}
 248:User/Tasks/Src/user_TasksInit.c **** 	}
 249:User/Tasks/Src/user_TasksInit.c **** 	user_HR_timecount+=1;
 250:User/Tasks/Src/user_TasksInit.c **** }
 251:User/Tasks/Src/user_TasksInit.c **** 
 252:User/Tasks/Src/user_TasksInit.c **** 
