 413:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      * divisor  multiplier  adder  min (0)  max (63)
 414:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       0           4      3        3       255
 415:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       1           8      6        3       255
