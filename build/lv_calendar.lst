 331:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c **** static uint8_t get_month_length(int32_t year, int32_t month)
 332:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c **** {
 333:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****     month--;
 334:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****     if(month < 0) {
 335:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****         year--;             /*Already in the previous year (won't be less then -12 to skip a whole 
 336:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****         month = 12 + month; /*`month` is negative, the result will be < 12*/
 337:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****     }
 338:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****     if(month >= 12) {
 339:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****         year++;
 340:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****         month -= 12;
 341:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****     }
 342:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c **** 
 343:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****     /*month == 1 is february*/
 344:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c ****     return (month == 1) ? (28 + is_leap_year(year)) : 31 - month % 7 % 2;
 345:Middlewares/LVGL/GUI/lvgl/src/extra/widgets/calendar/lv_calendar.c **** }
