 242:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** static lv_obj_t * find_scroll_obj(_lv_indev_proc_t * proc)
 243:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** {
 244:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     lv_obj_t * obj_candidate = NULL;
 245:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     lv_dir_t dir_candidate = LV_DIR_NONE;
 246:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     lv_indev_t * indev_act = lv_indev_get_act();
 247:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     lv_coord_t scroll_limit = indev_act->driver->scroll_limit;
 248:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 249:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     /*Go until find a scrollable object in the current direction
 250:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****      *More precisely:
 251:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****      * 1. Check the pressed object and all of its ancestors and try to find an object which is scro
 252:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****      * 2. Scrollable means it has some content out of its area
 253:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****      * 3. If an object can be scrolled into the current direction then use it ("real match"")
 254:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****      * 4. If can be scrolled on the current axis (hor/ver) save it as candidate (at least show an e
 255:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****      * 5. Use the last candidate. Always the "deepest" parent or the object from point 3*/
 256:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     lv_obj_t * obj_act = proc->types.pointer.act_obj;
 257:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 258:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     /*Decide if it's a horizontal or vertical scroll*/
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccStPZ77.s 			page 6


 259:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     bool hor_en = false;
 260:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     bool ver_en = false;
 261:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     if(LV_ABS(proc->types.pointer.scroll_sum.x) > LV_ABS(proc->types.pointer.scroll_sum.y)) {
 262:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         hor_en = true;
 263:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     }
 264:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     else {
 265:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         ver_en = true;
 266:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     }
 267:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 268:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     while(obj_act) {
 269:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if(lv_obj_has_flag(obj_act, LV_OBJ_FLAG_SCROLLABLE) == false) {
 270:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             /*If this object don't want to chain the scroll to the parent stop searching*/
 271:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             if(lv_obj_has_flag(obj_act, LV_OBJ_FLAG_SCROLL_CHAIN_HOR) == false && hor_en) break;
 272:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             if(lv_obj_has_flag(obj_act, LV_OBJ_FLAG_SCROLL_CHAIN_VER) == false && ver_en) break;
 273:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 274:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             obj_act = lv_obj_get_parent(obj_act);
 275:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             continue;
 276:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         }
 277:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 278:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         /*Consider both up-down or left/right scrollable according to the current direction*/
 279:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         bool up_en = ver_en;
 280:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         bool down_en = ver_en;
 281:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         bool left_en = hor_en;
 282:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         bool right_en = hor_en;
 283:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 284:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         /*The object might have disabled some directions.*/
 285:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         lv_dir_t scroll_dir = lv_obj_get_scroll_dir(obj_act);
 286:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if((scroll_dir & LV_DIR_LEFT) == 0) left_en = false;
 287:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if((scroll_dir & LV_DIR_RIGHT) == 0) right_en = false;
 288:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if((scroll_dir & LV_DIR_TOP) == 0) up_en = false;
 289:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if((scroll_dir & LV_DIR_BOTTOM) == 0) down_en = false;
 290:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 291:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         /*The object is scrollable to a direction if its content overflow in that direction.*/
 292:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         lv_coord_t st = lv_obj_get_scroll_top(obj_act);
 293:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         lv_coord_t sb = lv_obj_get_scroll_bottom(obj_act);
 294:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         lv_coord_t sl = lv_obj_get_scroll_left(obj_act);
 295:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         lv_coord_t sr = lv_obj_get_scroll_right(obj_act);
 296:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 297:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         /*If this object is scrollable into the current scroll direction then save it as a candidat
 298:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****          *It's important only to be scrollable on the current axis (hor/ver) because if the scroll
 299:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****          *is propagated to this object it can show at least elastic scroll effect.
 300:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****          *But if not hor/ver scrollable do not scroll it at all (so it's not a good candidate)*/
 301:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if((st > 0 || sb > 0)  &&
 302:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****            ((up_en    && proc->types.pointer.scroll_sum.y >=   scroll_limit) ||
 303:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             (down_en  && proc->types.pointer.scroll_sum.y <= - scroll_limit))) {
 304:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             obj_candidate = obj_act;
 305:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             dir_candidate = LV_DIR_VER;
 306:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         }
 307:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 308:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if((sl > 0 || sr > 0)  &&
 309:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****            ((left_en   && proc->types.pointer.scroll_sum.x >=   scroll_limit) ||
 310:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             (right_en  && proc->types.pointer.scroll_sum.x <= - scroll_limit))) {
 311:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             obj_candidate = obj_act;
 312:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             dir_candidate = LV_DIR_HOR;
 313:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         }
 314:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 315:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if(st <= 0) up_en = false;
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccStPZ77.s 			page 7


 316:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if(sb <= 0) down_en = false;
 317:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if(sl <= 0) left_en = false;
 318:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if(sr <= 0) right_en = false;
 319:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 320:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         /*If the object really can be scrolled into the current direction the use it.*/
 321:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if((left_en  && proc->types.pointer.scroll_sum.x >=   scroll_limit) ||
 322:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****            (right_en && proc->types.pointer.scroll_sum.x <= - scroll_limit) ||
 323:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****            (up_en    && proc->types.pointer.scroll_sum.y >=   scroll_limit) ||
 324:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****            (down_en  && proc->types.pointer.scroll_sum.y <= - scroll_limit)) {
