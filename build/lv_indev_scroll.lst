 201:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** /**
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccStPZ77.s 			page 5


 202:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****  * Predict where would a scroll throw end
 203:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****  * @param indev pointer to an input device
 204:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****  * @param dir `LV_DIR_VER` or `LV_DIR_HOR`
 205:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****  * @return the difference compared to the current position when the throw would be finished
 206:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****  */
 207:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** lv_coord_t lv_indev_scroll_throw_predict(lv_indev_t * indev, lv_dir_t dir)
 208:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** {
 209:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     if(indev == NULL) return 0;
 210:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     lv_coord_t v;
 211:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     switch(dir) {
 212:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         case LV_DIR_VER:
 213:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             v = indev->proc.types.pointer.scroll_throw_vect_ori.y;
 214:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             break;
 215:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         case LV_DIR_HOR:
 216:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             v = indev->proc.types.pointer.scroll_throw_vect_ori.x;
 217:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             break;
 218:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         default:
 219:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             return 0;
 220:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     }
 221:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 222:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     lv_coord_t scroll_throw = indev->driver->scroll_throw;
 223:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     lv_coord_t sum = 0;
 224:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     while(v) {
 225:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         sum += v;
 226:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         v = v * (100 - scroll_throw) / 100;
 227:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     }
 228:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 229:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     return sum;
 230:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** }
 231:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 232:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** void lv_indev_scroll_get_snap_dist(lv_obj_t * obj, lv_point_t * p)
 233:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** {
 234:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     p->x = find_snap_point_x(obj, obj->coords.x1, obj->coords.x2, 0);
 235:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     p->y = find_snap_point_y(obj, obj->coords.y1, obj->coords.y2, 0);
 236:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** }
 237:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
