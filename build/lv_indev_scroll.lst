 195:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 196:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         proc->types.pointer.scroll_dir = LV_DIR_NONE;
 197:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         proc->types.pointer.scroll_obj = NULL;
 198:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     }
 199:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** }
