 180:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if(align_x == LV_SCROLL_SNAP_NONE) {
 181:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             lv_coord_t sl = lv_obj_get_scroll_left(scroll_obj);
 182:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             lv_coord_t sr = lv_obj_get_scroll_right(scroll_obj);
 183:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             if(sl > 0 || sr > 0) {
