 326:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****             break;
 327:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         }
 328:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 329:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         /*If this object don't want to chain the scroll to the parent stop searching*/
 330:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if(lv_obj_has_flag(obj_act, LV_OBJ_FLAG_SCROLL_CHAIN_HOR) == false && hor_en) break;
 331:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         if(lv_obj_has_flag(obj_act, LV_OBJ_FLAG_SCROLL_CHAIN_VER) == false && ver_en) break;
 332:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c **** 
 333:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         /*Try the parent*/
 334:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****         obj_act = lv_obj_get_parent(obj_act);
 335:Middlewares/LVGL/GUI/lvgl/src/core/lv_indev_scroll.c ****     }
