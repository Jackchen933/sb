 604:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****                     r = ((c & 0xFF0000) >> 19)
 605:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****                     g = ((c & 0xFF00) >> 10)
 606:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****                     b = ((c & 0xFF) >> 3)
 607:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****                     rgb565 = (r << 11) | (g << 5) | b
 608:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****         That's 3 mask, 5 bitshift and 2 or operations
 609:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** 
 610:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****         A bit better:
 611:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****                     r = ((c & 0xF80000) >> 8)
 612:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****                     g = ((c & 0xFC00) >> 5)
 613:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****                     b = ((c & 0xFF) >> 3)
