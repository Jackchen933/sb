 379:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** static inline uint32_t lv_color_to32(lv_color_t color)
 380:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** {
 381:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** #if LV_COLOR_DEPTH == 1
 382:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     if(color.full == 0)
 383:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****         return 0xFF000000;
 384:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     else
 385:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****         return 0xFFFFFFFF;
 386:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** #elif LV_COLOR_DEPTH == 8
 387:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     lv_color32_t ret;
 388:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     LV_COLOR_SET_R32(ret, LV_COLOR_GET_R(color) * 36); /*(2^8 - 1)/(2^3 - 1) = 255/7 = 36*/
 389:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     LV_COLOR_SET_G32(ret, LV_COLOR_GET_G(color) * 36); /*(2^8 - 1)/(2^3 - 1) = 255/7 = 36*/
 390:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     LV_COLOR_SET_B32(ret, LV_COLOR_GET_B(color) * 85); /*(2^8 - 1)/(2^2 - 1) = 255/3 = 85*/
 391:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     LV_COLOR_SET_A32(ret, 0xFF);
 392:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     return ret.full;
 393:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** #elif LV_COLOR_DEPTH == 16
 394:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     /**
 395:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      * The floating point math for conversion is:
 396:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *  valueto = valuefrom * ( (2^bitsto - 1) / (float)(2^bitsfrom - 1) )
 397:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      * The faster integer math for conversion is:
 398:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *  valueto = ( valuefrom * multiplier + adder ) >> divisor
 399:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *   multiplier = FLOOR( ( (2^bitsto - 1) << divisor ) / (float)(2^bitsfrom - 1) )
 400:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *
 401:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      * Find the first divisor where ( adder >> divisor ) <= 0
 402:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *
 403:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      * 5-bit to 8-bit: ( 31 * multiplier + adder ) >> divisor = 255
 404:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      * divisor  multiplier  adder  min (0)  max (31)
 405:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       0           8      7        7       255
 406:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       1          16     14        7       255
 407:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       2          32     28        7       255
 408:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       3          65     25        3       255
 409:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       4         131     19        1       255
 410:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       5         263      7        0       255
 411:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *
 412:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      * 6-bit to 8-bit: 255 = ( 63 * multiplier + adder ) >> divisor
 413:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      * divisor  multiplier  adder  min (0)  max (63)
 414:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       0           4      3        3       255
 415:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       1           8      6        3       255
 416:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       2          16     12        3       255
 417:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       3          32     24        3       255
 418:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       4          64     48        3       255
 419:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       5         129     33        1       255
 420:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      *       6         259      3        0       255
 421:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****      */
 422:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** 
 423:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     lv_color32_t ret;
 424:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     LV_COLOR_SET_R32(ret, (LV_COLOR_GET_R(color) * 263 + 7) >> 5);
 425:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     LV_COLOR_SET_G32(ret, (LV_COLOR_GET_G(color) * 259 + 3) >> 6);
 426:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     LV_COLOR_SET_B32(ret, (LV_COLOR_GET_B(color) * 263 + 7) >> 5);
 427:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     LV_COLOR_SET_A32(ret, 0xFF);
 428:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     return ret.full;
 429:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** #elif LV_COLOR_DEPTH == 32
 430:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     return color.full;
 431:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** #endif
