 346:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****  * Get elapsed time since last user activity on a display (e.g. click)
 347:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****  * @param disp pointer to a display (NULL to get the overall smallest inactivity)
 348:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****  * @return elapsed ticks (milliseconds) since the last activity
 349:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****  */
 350:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c **** uint32_t lv_disp_get_inactive_time(const lv_disp_t * disp)
 351:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c **** {
 352:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****     if(disp) return lv_tick_elaps(disp->last_activity_time);
 353:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c **** 
 354:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****     lv_disp_t * d;
 355:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****     uint32_t t = UINT32_MAX;
 356:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****     d          = lv_disp_get_next(NULL);
 357:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****     while(d) {
 358:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****         uint32_t elaps = lv_tick_elaps(d->last_activity_time);
 359:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****         t = LV_MIN(t, elaps);
 360:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****         d = lv_disp_get_next(d);
 361:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****     }
 362:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c **** 
 363:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c ****     return t;
 364:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c **** }
 365:Middlewares/LVGL/GUI/lvgl/src/core/lv_disp.c **** 
