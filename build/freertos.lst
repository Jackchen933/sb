  88:Core/Src/freertos.c **** {
  89:Core/Src/freertos.c ****    /* This function will be called by each tick interrupt if
  90:Core/Src/freertos.c ****    configUSE_TICK_HOOK is set to 1 in FreeRTOSConfig.h. User code can be
  91:Core/Src/freertos.c ****    added here, but the tick hook is called from an interrupt context, so
  92:Core/Src/freertos.c ****    code must not attempt to block, and only the interrupt safe FreeRTOS API
  93:Core/Src/freertos.c ****    functions can be used (those that end in FromISR()). */
  94:Core/Src/freertos.c **** 	TaskTickHook();
  95:Core/Src/freertos.c **** }
