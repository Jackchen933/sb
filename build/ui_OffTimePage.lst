 355:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** static inline uint16_t lv_color_to16(lv_color_t color)
 356:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** {
 357:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** #if LV_COLOR_DEPTH == 1
