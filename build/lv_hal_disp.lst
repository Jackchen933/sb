 290:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** /*In color conversations:
 291:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  * - When converting to bigger color type the LSB weight of 1 LSB is calculated
 292:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *   E.g. 16 bit Red has 5 bits
 293:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *         8 bit Red has 3 bits
 294:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *        ----------------------
 295:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *        8 bit red LSB = (2^5 - 1) / (2^3 - 1) = 31 / 7 = 4
 296:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *
 297:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  * - When calculating to smaller color type simply shift out the LSBs
 298:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *   E.g.  8 bit Red has 3 bits
 299:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *        16 bit Red has 5 bits
 300:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *        ----------------------
 301:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  *         Shift right with 5 - 3 = 2
 302:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****  */
 303:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** static inline uint8_t lv_color_to1(lv_color_t color)
 304:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** {
 305:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** #if LV_COLOR_DEPTH == 1
 306:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     return color.full;
 307:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** #elif LV_COLOR_DEPTH == 8
 308:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     if((LV_COLOR_GET_R(color) & 0x4) || (LV_COLOR_GET_G(color) & 0x4) || (LV_COLOR_GET_B(color) & 0
 309:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****         return 1;
 310:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     }
 311:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     else {
 312:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****         return 0;
 313:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     }
 314:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h **** #elif LV_COLOR_DEPTH == 16
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc9XlEmc.s 			page 7


 315:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     if((LV_COLOR_GET_R(color) & 0x10) || (LV_COLOR_GET_G(color) & 0x20) || (LV_COLOR_GET_B(color) &
 316:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****         return 1;
 317:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     }
 318:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     else {
