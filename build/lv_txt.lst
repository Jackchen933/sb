 139:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c **** /**
 140:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * Get the next word of text. A word is delimited by break characters.
 141:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *
 142:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * If the word cannot fit in the max_width space, obey LV_TXT_LINE_BREAK_LONG_* rules.
 143:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *
 144:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * If the next word cannot fit anything, return 0.
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccGt9MQG.s 			page 4


 145:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *
 146:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * If the first character is a break character, returns the next index.
 147:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *
 148:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * Example calls from lv_txt_get_next_line() assuming sufficient max_width and
 149:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * txt = "Test text\n"
 150:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *        0123456789
 151:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *
 152:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * Calls would be as follows:
 153:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *     1. Return i=4, pointing at breakchar ' ', for the string "Test"
 154:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *     2. Return i=5, since i=4 was a breakchar.
 155:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *     3. Return i=9, pointing at breakchar '\n'
 156:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *     4. Parenting lv_txt_get_next_line() would detect subsequent '\0'
 157:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *
 158:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * TODO: Returned word_w_ptr may overestimate the returned word's width when
 159:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * max_width is reached. In current usage, this has no impact.
 160:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  *
 161:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * @param txt a '\0' terminated string
 162:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * @param font pointer to a font
 163:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * @param letter_space letter space
 164:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * @param max_width max with of the text (break the lines to fit this size) Set CORD_MAX to avoid l
 165:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * @param flags settings for the text from 'txt_flag_type' enum
 166:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * @param[out] word_w_ptr width (in pixels) of the parsed word. May be NULL.
 167:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * @param force Force return the fraction of the word that can fit in the provided space.
 168:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  * @return the index of the first char of the next word (in byte index not letter index. With UTF-8
 169:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****  */
 170:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c **** static uint32_t lv_txt_get_next_word(const char * txt, const lv_font_t * font,
 171:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****                                      lv_coord_t letter_space, lv_coord_t max_width,
 172:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****                                      lv_text_flag_t flag, uint32_t * word_w_ptr, lv_text_cmd_state_
 173:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c **** {
 174:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     if(txt == NULL || txt[0] == '\0') return 0;
 175:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     if(font == NULL) return 0;
 176:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c **** 
 177:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     if(flag & LV_TEXT_FLAG_EXPAND) max_width = LV_COORD_MAX;
 178:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c **** 
 179:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     uint32_t i = 0, i_next = 0, i_next_next = 0;  /*Iterating index into txt*/
 180:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     uint32_t letter = 0;      /*Letter at i*/
 181:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     uint32_t letter_next = 0; /*Letter at i_next*/
 182:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     lv_coord_t letter_w;
 183:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     lv_coord_t cur_w = 0;  /*Pixel Width of transversed string*/
