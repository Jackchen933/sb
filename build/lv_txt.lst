 381:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c **** bool _lv_txt_is_cmd(lv_text_cmd_state_t * state, uint32_t c)
 382:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c **** {
 383:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     bool ret = false;
 384:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c **** 
 385:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     if(c == (uint32_t)LV_TXT_COLOR_CMD[0]) {
 386:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****         if(*state == LV_TEXT_CMD_STATE_WAIT) { /*Start char*/
 387:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****             *state = LV_TEXT_CMD_STATE_PAR;
 388:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****             ret    = true;
 389:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****         }
 390:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****         /*Other start char in parameter is escaped cmd. char*/
 391:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****         else if(*state == LV_TEXT_CMD_STATE_PAR) {
 392:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****             *state = LV_TEXT_CMD_STATE_WAIT;
 393:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****         }
 394:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****         /*Command end*/
 395:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****         else if(*state == LV_TEXT_CMD_STATE_IN) {
 396:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****             *state = LV_TEXT_CMD_STATE_WAIT;
 397:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****             ret    = true;
 398:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****         }
 399:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     }
 400:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c **** 
 401:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     /*Skip the color parameter and wait the space after it*/
 402:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****     if(*state == LV_TEXT_CMD_STATE_PAR) {
 403:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****         if(c == ' ') {
 404:Middlewares/LVGL/GUI/lvgl/src/misc/lv_txt.c ****             *state = LV_TEXT_CMD_STATE_IN; /*After the parameter the text is in the command*/
