 432:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         /*Do not allow big jumps.
 433:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****          *It's mainly to avoid jumping to the opposite end if the "dead" range between min. and max
 434:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****          *Check which end was closer on the last valid press (arc->min_close) and prefer that end*/
 435:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         if(LV_ABS(delta_angle) > 280) {
 436:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****             if(arc->min_close) angle = 0;
 437:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****             else angle = deg_range;
 438:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         }
 439:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         else {
 440:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****             if(angle < deg_range / 2)arc->min_close = 1;
 441:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****             else arc->min_close = 0;
 442:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         }
 443:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 444:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         /*Calculate the slew rate limited angle based on change rate (degrees/sec)*/
 445:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         delta_angle = angle - last_angle_rel;
 446:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         uint32_t delta_tick = lv_tick_elaps(arc->last_tick);
 447:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         int16_t delta_angle_max = (arc->chg_rate * delta_tick) / 1000;
 448:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 449:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         if(delta_angle > delta_angle_max) {
 450:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****             delta_angle = delta_angle_max;
 451:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         }
 452:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         else if(delta_angle < -delta_angle_max) {
 453:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****             delta_angle = -delta_angle_max;
 454:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         }
 455:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 456:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         angle = last_angle_rel + delta_angle; /*Apply the limited angle change*/
 457:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 458:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         /*Rounding for symmetry*/
 459:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         int32_t round = ((bg_end - arc->bg_angle_start) * 8) / (arc->max_value - arc->min_value);
