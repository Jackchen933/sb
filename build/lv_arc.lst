 240:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** void lv_arc_set_range(lv_obj_t * obj, int16_t min, int16_t max)
 241:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** {
 242:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
 243:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     lv_arc_t * arc = (lv_arc_t *)obj;
 244:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 245:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     if(arc->min_value == min && arc->max_value == max) return;
 246:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 247:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     arc->min_value = min;
 248:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     arc->max_value = max;
 249:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 250:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     if(arc->value < min) {
 251:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****         arc->value = min;
 252:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     }
