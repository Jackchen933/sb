 227:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 228:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     if(arc->value == value) return;
 229:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 230:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     int16_t new_value;
 231:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     new_value = value > arc->max_value ? arc->max_value : value;
 232:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     new_value = new_value < arc->min_value ? arc->min_value : new_value;
 233:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 234:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     if(arc->value == new_value) return;
 235:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     arc->value = new_value;
 236:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** 
 237:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c ****     value_update(obj);
 238:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_arc.c **** }
