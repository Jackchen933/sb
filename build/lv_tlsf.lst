 567:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****         const unsigned int fl_map = control->fl_bitmap & (~0U << (fl + 1));
 568:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****         if(!fl_map) {
 569:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****             /* No free blocks available, memory has been exhausted. */
