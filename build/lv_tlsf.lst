 560:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     /*
 561:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     ** First, search for a block in the list associated with the given
 562:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     ** fl/sl index.
 563:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     */
 564:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     unsigned int sl_map = control->sl_bitmap[fl] & (~0U << sl);
