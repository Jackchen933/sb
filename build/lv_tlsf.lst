 311:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** /*
 312:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** Block header structure.
 313:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** **
 314:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** There are several implementation subtleties involved:
 315:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** - The prev_phys_block field is only valid if the previous block is free.
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccNtxiLc.s 			page 7


 316:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** - The prev_phys_block field is actually stored at the end of the
 317:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** **   previous block. It appears at the beginning of this structure only to
 318:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** **   simplify the implementation.
 319:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** - The next_free / prev_free fields are only valid if the block is free.
 320:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** */
 321:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** typedef struct block_header_t {
 322:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     /* Points to the previous physical block. */
 323:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     struct block_header_t * prev_phys_block;
 324:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** 
 325:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     /* The size of this block, excluding the block header. */
 326:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     size_t size;
 327:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** 
 328:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     /* Next and previous free blocks. */
 329:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     struct block_header_t * next_free;
 330:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     struct block_header_t * prev_free;
 331:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** } block_header_t;
 332:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** 
 333:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** /*
 334:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** Since block sizes are always at least a multiple of 4, the two least
 335:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** significant bits of the size field are used to store the block status:
 336:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** - bit 0: whether block is busy or free
 337:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** - bit 1: whether previous block is busy or free
 338:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** */
 339:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** static const size_t block_header_free_bit = 1 << 0;
 340:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** static const size_t block_header_prev_free_bit = 1 << 1;
 341:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** 
 342:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** /*
 343:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** The size of the block header exposed to used blocks is the size field.
 344:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** The prev_phys_block field is stored *inside* the previous free block.
 345:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** */
 346:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** static const size_t block_header_overhead = sizeof(size_t);
 347:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** 
 348:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** /* User data starts directly after the size field in a used block. */
 349:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** static const size_t block_start_offset =
 350:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     offsetof(block_header_t, size) + sizeof(size_t);
 351:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** 
 352:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** /*
 353:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** A free block must be large enough to store its header minus the size of
 354:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** the prev_phys_block field, and no larger than the number of addressable
 355:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** bits for FL_INDEX.
 356:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** */
 357:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** static const size_t block_size_min =
 358:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     sizeof(block_header_t) - sizeof(block_header_t *);
 359:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** static const size_t block_size_max = tlsf_cast(size_t, 1) << FL_INDEX_MAX;
 360:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** 
 361:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** 
 362:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** /* The TLSF control structure. */
 363:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** typedef struct control_t {
 364:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     /* Empty lists point at this block to indicate they are free. */
 365:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     block_header_t block_null;
 366:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** 
