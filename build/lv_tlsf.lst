  86:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** {
  87:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c ****     const unsigned int reverse = word & (~word + 1);
