1174:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** /*
1175:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** The TLSF block information provides us with enough information to
1176:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** provide a reasonably intelligent implementation of realloc, growing or
1177:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** shrinking the currently allocated block as required.
1178:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** **
1179:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** This routine handles the somewhat esoteric edge cases of realloc:
1180:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** - a non-zero size with a null pointer will behave like malloc
1181:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** - a zero size with a non-null pointer will behave like free
1182:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** - a request that cannot be satisfied will leave the original buffer
1183:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** **   untouched
1184:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** ** - an extended buffer size will leave the newly-allocated area with
1185:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** **   contents undefined
1186:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** */
1187:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** void * lv_tlsf_realloc(lv_tlsf_t tlsf, void * ptr, size_t size)
1188:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** {
 3804              		.loc 1 1188 1 is_stmt 1 view -0
 3805              		.cfi_startproc
