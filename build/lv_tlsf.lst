 545:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** /* This version rounds up to the next block size (for allocations) */
 546:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** static void mapping_search(size_t size, int * fli, int * sli)
 547:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** {
