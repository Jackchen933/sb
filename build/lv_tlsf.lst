 304:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** /* Ensure we've properly tuned our sizes. */
 305:Middlewares/LVGL/GUI/lvgl/src/misc/lv_tlsf.c **** tlsf_static_assert(ALIGN_SIZE == SMALL_BLOCK_SIZE / SL_INDEX_COUNT);
