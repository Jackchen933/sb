 106:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** void lv_area_increase(lv_area_t * area, lv_coord_t w_extra, lv_coord_t h_extra)
 107:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** {
 108:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     area->x1 -= w_extra;
 109:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     area->x2 += w_extra;
 110:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     area->y1 -= h_extra;
 111:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     area->y2 += h_extra;
 112:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** }
 113:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** 
 114:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** void lv_area_move(lv_area_t * area, lv_coord_t x_ofs, lv_coord_t y_ofs)
 115:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** {
 116:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     area->x1 += x_ofs;
 117:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     area->x2 += x_ofs;
 118:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     area->y1 += y_ofs;
 119:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     area->y2 += y_ofs;
 120:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** }
 121:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** 
 122:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** /**
 123:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * Get the common parts of two areas
 124:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param res_p pointer to an area, the result will be stored here
 125:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param a1_p pointer to the first area
 126:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param a2_p pointer to the second area
 127:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @return false: the two area has NO common parts, res_p is invalid
 128:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  */
 129:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** bool _lv_area_intersect(lv_area_t * res_p, const lv_area_t * a1_p, const lv_area_t * a2_p)
 130:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** {
 131:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     /*Get the smaller area from 'a1_p' and 'a2_p'*/
 132:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     res_p->x1 = LV_MAX(a1_p->x1, a2_p->x1);
 133:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     res_p->y1 = LV_MAX(a1_p->y1, a2_p->y1);
 134:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     res_p->x2 = LV_MIN(a1_p->x2, a2_p->x2);
 135:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     res_p->y2 = LV_MIN(a1_p->y2, a2_p->y2);
 136:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** 
 137:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     /*If x1 or y1 greater than x2 or y2 then the areas union is empty*/
 138:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     bool union_ok = true;
 139:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     if((res_p->x1 > res_p->x2) || (res_p->y1 > res_p->y2)) {
 140:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         union_ok = false;
 141:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     }
 142:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** 
 143:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     return union_ok;
 144:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** }
