 146:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** /**
 147:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * Join two areas into a third which involves the other two
 148:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param res_p pointer to an area, the result will be stored here
 149:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param a1_p pointer to the first area
 150:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param a2_p pointer to the second area
 151:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  */
 152:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** void _lv_area_join(lv_area_t * a_res_p, const lv_area_t * a1_p, const lv_area_t * a2_p)
 153:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** {
 154:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     a_res_p->x1 = LV_MIN(a1_p->x1, a2_p->x1);
 155:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     a_res_p->y1 = LV_MIN(a1_p->y1, a2_p->y1);
 156:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     a_res_p->x2 = LV_MAX(a1_p->x2, a2_p->x2);
 157:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     a_res_p->y2 = LV_MAX(a1_p->y2, a2_p->y2);
 158:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** }
 159:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** 
 160:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** /**
 161:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * Check if a point is on an area
 162:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param a_p pointer to an area
 163:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param p_p pointer to a point
 164:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param radius radius of area (e.g. for rounded rectangle)
 165:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @return false:the point is out of the area
 166:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  */
 167:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** bool _lv_area_is_point_on(const lv_area_t * a_p, const lv_point_t * p_p, lv_coord_t radius)
 168:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** {
 169:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     /*First check the basic area*/
 170:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     bool is_on_rect = false;
 171:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     if((p_p->x >= a_p->x1 && p_p->x <= a_p->x2) && ((p_p->y >= a_p->y1 && p_p->y <= a_p->y2))) {
 172:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         is_on_rect = true;
 173:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     }
 174:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     if(!is_on_rect)
 175:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         return false;
 176:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     /*Now handle potential rounded rectangles*/
 177:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     if(radius <= 0) {
 178:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         /*No radius, it is within the rectangle*/
 179:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         return true;
 180:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     }
 181:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     lv_coord_t w = lv_area_get_width(a_p) / 2;
 182:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     lv_coord_t h = lv_area_get_height(a_p) / 2;
 183:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     lv_coord_t max_radius = LV_MIN(w, h);
 184:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     if(radius > max_radius)
 185:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         radius = max_radius;
 186:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** 
 187:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     /*Check if it's in one of the corners*/
 188:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     lv_area_t corner_area;
 189:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     /*Top left*/
 190:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     corner_area.x1 = a_p->x1;
 191:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     corner_area.x2 = a_p->x1 + radius;
 192:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     corner_area.y1 = a_p->y1;
 193:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     corner_area.y2 = a_p->y1 + radius;
 194:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     if(_lv_area_is_point_on(&corner_area, p_p, 0)) {
 195:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         corner_area.x2 += radius;
 196:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         corner_area.y2 += radius;
 197:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         return lv_point_within_circle(&corner_area, p_p);
 198:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     }
 199:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     /*Bottom left*/
 200:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     corner_area.y1 = a_p->y2 - radius;
 201:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     corner_area.y2 = a_p->y2;
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccd99HMI.s 			page 5


 202:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     if(_lv_area_is_point_on(&corner_area, p_p, 0)) {
 203:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         corner_area.x2 += radius;
 204:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         corner_area.y1 -= radius;
 205:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****         return lv_point_within_circle(&corner_area, p_p);
