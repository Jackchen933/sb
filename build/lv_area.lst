  92:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** /**
  93:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * Return with area of an area (x * y)
  94:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @param area_p pointer to an area
  95:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  * @return size of area
  96:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****  */
  97:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** uint32_t lv_area_get_size(const lv_area_t * area_p)
  98:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** {
  99:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     uint32_t size;
 100:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** 
 101:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     size = (uint32_t)(area_p->x2 - area_p->x1 + 1) * (area_p->y2 - area_p->y1 + 1);
 102:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** 
 103:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c ****     return size;
 104:Middlewares/LVGL/GUI/lvgl/src/misc/lv_area.c **** }
