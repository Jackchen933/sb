 116:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****     res = lv_obj_event_base(MY_CLASS, e);
 117:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****     if(res != LV_RES_OK) return;
 118:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c **** 
