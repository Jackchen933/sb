 121:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c **** 
 122:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****     if(code == LV_EVENT_REFR_EXT_DRAW_SIZE) {
 123:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         lv_coord_t knob_left = lv_obj_get_style_pad_left(obj,   LV_PART_KNOB);
 124:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         lv_coord_t knob_right = lv_obj_get_style_pad_right(obj,  LV_PART_KNOB);
