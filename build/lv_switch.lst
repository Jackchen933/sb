 126:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         lv_coord_t knob_bottom = lv_obj_get_style_pad_bottom(obj, LV_PART_KNOB);
 127:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c **** 
 128:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         /*The smaller size is the knob diameter*/
 129:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         lv_coord_t knob_size = LV_MAX4(knob_left, knob_right, knob_bottom, knob_top);
 130:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         knob_size += _LV_SWITCH_KNOB_EXT_AREA_CORRECTION;
 131:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         knob_size += lv_obj_calculate_ext_draw_size(obj, LV_PART_KNOB);
 132:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c **** 
 133:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         lv_coord_t * s = lv_event_get_param(e);
 134:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         *s = LV_MAX(*s, knob_size);
 135:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****         *s = LV_MAX(*s, lv_obj_calculate_ext_draw_size(obj, LV_PART_INDICATOR));
 136:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****     }
 137:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_switch.c ****     else if(code == LV_EVENT_VALUE_CHANGED) {
