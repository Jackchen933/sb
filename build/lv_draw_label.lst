 405:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      *       0           8      7        7       255
 406:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      *       1          16     14        7       255
 407:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      *       2          32     28        7       255
 408:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      *       3          65     25        3       255
