 263:User/GUI_App/Screens/Src/ui_Game2048Page.c **** static void addRandom(uint16_t matrix[MATRIX_SIZE][MATRIX_SIZE])
 264:User/GUI_App/Screens/Src/ui_Game2048Page.c **** {
 265:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     static uint8_t initialized = 0;
 266:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     uint16_t x, y;
 267:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     uint16_t r, len = 0;
 268:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     uint16_t n, list[MATRIX_SIZE * MATRIX_SIZE][2];
 269:User/GUI_App/Screens/Src/ui_Game2048Page.c **** 
 270:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     if (!initialized)
 271:User/GUI_App/Screens/Src/ui_Game2048Page.c **** 		{
 272:User/GUI_App/Screens/Src/ui_Game2048Page.c **** 			int time=0;
 273:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             HW_DateTimeTypeDef nowtime;
 274:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             HWInterface.RealTimeClock.GetTimeDate(&nowtime);
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccOmfaCl.s 			page 9


 275:User/GUI_App/Screens/Src/ui_Game2048Page.c **** 			time = nowtime.Seconds;
 276:User/GUI_App/Screens/Src/ui_Game2048Page.c ****       srand(time);
 277:User/GUI_App/Screens/Src/ui_Game2048Page.c ****       initialized = 1;
 278:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     }
 279:User/GUI_App/Screens/Src/ui_Game2048Page.c **** 
 280:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     for (x = 0; x < MATRIX_SIZE; x++) {
 281:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         for (y = 0; y < MATRIX_SIZE; y++) {
 282:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             if (matrix[x][y] == 0) {
 283:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 list[len][0] = x;
 284:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 list[len][1] = y;
 285:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 len++;
 286:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             }
 287:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         }
 288:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     }
 289:User/GUI_App/Screens/Src/ui_Game2048Page.c **** 
 290:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     if (len > 0) {
 291:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         r = rand() % len;
 292:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         x = list[r][0];
 293:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         y = list[r][1];
 294:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         n = ((rand() % 10) / 9) + 1;
 295:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         matrix[x][y] = n;
 296:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     }
 297:User/GUI_App/Screens/Src/ui_Game2048Page.c **** }
 298:User/GUI_App/Screens/Src/ui_Game2048Page.c **** 
 299:User/GUI_App/Screens/Src/ui_Game2048Page.c **** static uint8_t move_up(uint16_t * score, uint16_t matrix[MATRIX_SIZE][MATRIX_SIZE])
 300:User/GUI_App/Screens/Src/ui_Game2048Page.c **** {
 301:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     uint8_t moved = 0;
 302:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     uint8_t x,y;
 303:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     Stack_T num_stack;
 304:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     Stack_init(&num_stack);
 305:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     for (y = 0; y < MATRIX_SIZE; y++)
 306:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     {
 307:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         for(x=0; x<MATRIX_SIZE; x++)
 308:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         {
 309:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             if(matrix[MATRIX_SIZE-x-1][y] != 0)
 310:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 Stack_Push(&num_stack,matrix[MATRIX_SIZE-x-1][y]);
 311:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             else if(x > 0 && matrix[MATRIX_SIZE-x][y] != 0)
 312:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 moved = 1;
 313:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             if(num_stack.Top_Point>1)
 314:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             {
 315:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 if(num_stack.Data[num_stack.Top_Point-1] == num_stack.Data[num_stack.Top_Point-2])
 316:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 {
 317:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     uint16_t temp;
 318:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     temp = num_stack.Data[num_stack.Top_Point-1] + 1;
 319:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     Stack_Pop(&num_stack);
 320:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     Stack_Pop(&num_stack);
 321:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     Stack_Push(&num_stack,temp);
 322:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     *score += 1<<(temp-1);
 323:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     moved = 1;
 324:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 }
 325:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             }
 326:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         }
 327:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         if(moved)
 328:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         {
 329:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             for(x=0; x<MATRIX_SIZE; x++)
 330:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             {
 331:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 if(!Stack_isEmpty(&num_stack))
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccOmfaCl.s 			page 10


 332:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 {
 333:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     matrix[x][y] = num_stack.Data[num_stack.Top_Point-1];
 334:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     Stack_Pop(&num_stack);
 335:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 }
 336:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 else
 337:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 {
 338:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                     matrix[x][y] = 0;
 339:User/GUI_App/Screens/Src/ui_Game2048Page.c ****                 }
 340:User/GUI_App/Screens/Src/ui_Game2048Page.c **** 
 341:User/GUI_App/Screens/Src/ui_Game2048Page.c ****             }
 342:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         }
 343:User/GUI_App/Screens/Src/ui_Game2048Page.c ****         Stack_Clear(&num_stack);
 344:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     }
 345:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     return moved;
 346:User/GUI_App/Screens/Src/ui_Game2048Page.c **** }
 347:User/GUI_App/Screens/Src/ui_Game2048Page.c **** 
 348:User/GUI_App/Screens/Src/ui_Game2048Page.c **** static uint8_t move_down(uint16_t * score, uint16_t matrix[MATRIX_SIZE][MATRIX_SIZE])
 349:User/GUI_App/Screens/Src/ui_Game2048Page.c **** {
 350:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     uint8_t moved = 0;
 351:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     uint8_t x,y;
 352:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     Stack_T num_stack;
 353:User/GUI_App/Screens/Src/ui_Game2048Page.c ****     Stack_init(&num_stack);
