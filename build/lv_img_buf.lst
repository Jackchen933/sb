 586:Middlewares/LVGL/GUI/lvgl/src/draw/lv_img_buf.c ****         yt = (int32_t)((int32_t)yt * dsc->tmp.zoom_inv) >> _LV_ZOOM_INV_UPSCALE;
 587:Middlewares/LVGL/GUI/lvgl/src/draw/lv_img_buf.c ****         xs = xt + dsc->tmp.pivot_x_256;
