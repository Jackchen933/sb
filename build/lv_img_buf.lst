 579:Middlewares/LVGL/GUI/lvgl/src/draw/lv_img_buf.c ****     if(dsc->cfg.zoom == LV_IMG_ZOOM_NONE) {
 580:Middlewares/LVGL/GUI/lvgl/src/draw/lv_img_buf.c ****         /*Get the source pixel from the upscaled image*/
