 573:Middlewares/LVGL/GUI/lvgl/src/draw/lv_img_buf.c ****     /*Get the target point relative coordinates to the pivot*/
 574:Middlewares/LVGL/GUI/lvgl/src/draw/lv_img_buf.c ****     int32_t xt = x - dsc->cfg.pivot_x;
 575:Middlewares/LVGL/GUI/lvgl/src/draw/lv_img_buf.c ****     int32_t yt = y - dsc->cfg.pivot_y;
 576:Middlewares/LVGL/GUI/lvgl/src/draw/lv_img_buf.c **** 
