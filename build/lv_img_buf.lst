 301:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****  *         Shift right with 5 - 3 = 2
 302:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****  */
