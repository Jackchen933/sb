 323:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****         return 1;
 324:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     }
 325:Middlewares/LVGL/GUI/lvgl/src/hal/../draw/../misc/lv_color.h ****     else {
