  30:SYSTEM/delay.c **** #if OS_SUPPORT 						    								   
  31:SYSTEM/delay.c **** void delay_us(u32 nus)
  32:SYSTEM/delay.c **** {		
  33:SYSTEM/delay.c **** 	u32 ticks;
  34:SYSTEM/delay.c **** 	u32 told,tnow,tcnt=0;
  35:SYSTEM/delay.c **** 	u32 reload=SysTick->LOAD;				   	 
  36:SYSTEM/delay.c **** 	ticks=nus*SYS_CLK; 						 
  37:SYSTEM/delay.c **** 	delay_osschedlock();					
  38:SYSTEM/delay.c **** 	told=SysTick->VAL;        				
  39:SYSTEM/delay.c **** 	while(1)
  40:SYSTEM/delay.c **** 	{
  41:SYSTEM/delay.c **** 		tnow=SysTick->VAL;	
  42:SYSTEM/delay.c **** 		if(tnow!=told)
  43:SYSTEM/delay.c **** 		{	    
  44:SYSTEM/delay.c **** 			if(tnow<told)tcnt+=told-tnow;//这里注意一下SYSTICK是一个递减的计数器就可以了.	
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccs8e2ae.s 			page 3


  45:SYSTEM/delay.c **** 			else tcnt+=reload-tnow+told;	    
  46:SYSTEM/delay.c **** 			told=tnow;
  47:SYSTEM/delay.c **** 			if(tcnt>=ticks)break;			
  48:SYSTEM/delay.c **** 		}  
  49:SYSTEM/delay.c **** 	};
  50:SYSTEM/delay.c **** 	delay_osschedunlock();															    
  51:SYSTEM/delay.c **** }  
  52:SYSTEM/delay.c **** 
  53:SYSTEM/delay.c **** void delay_ms(u16 nms)
  54:SYSTEM/delay.c **** {	
  55:SYSTEM/delay.c **** 	if(delay_osrunning&&delay_osintnesting==0)    
  56:SYSTEM/delay.c **** 	{		 
  57:SYSTEM/delay.c **** 		if(nms>=fac_ms)						
  58:SYSTEM/delay.c **** 		{ 
  59:SYSTEM/delay.c ****    			delay_ostimedly(nms/fac_ms);	
  60:SYSTEM/delay.c **** 		}
  61:SYSTEM/delay.c **** 		nms%=fac_ms;						 
  62:SYSTEM/delay.c **** 	}
  63:SYSTEM/delay.c **** 	delay_us((u32)(nms*1000));			
  64:SYSTEM/delay.c **** }
