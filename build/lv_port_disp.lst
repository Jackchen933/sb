  54:Middlewares/LVGL/GUI/porting/lv_port_disp.c **** 
  55:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****     /*-----------------------------
  56:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      * Create a buffer for drawing
  57:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *----------------------------*/
  58:Middlewares/LVGL/GUI/porting/lv_port_disp.c **** 
  59:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****     /**
  60:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      * LVGL requires a buffer where it internally draws the widgets.
  61:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      * Later this buffer will passed to your display driver's `flush_cb` to copy its content to you
  62:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      * The buffer has to be greater than 1 display row
  63:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *
  64:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      * There are 3 buffering configurations:
  65:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      * 1. Create ONE buffer:
  66:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *      LVGL will draw the display's content here and writes it to your display
  67:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *
  68:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      * 2. Create TWO buffer:
  69:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *      LVGL will draw the display's content to a buffer and writes it your display.
  70:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *      You should use DMA to write the buffer's content to the display.
  71:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *      It will enable LVGL to draw the next part of the screen to the other buffer while
  72:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *      the data is being sent form the first buffer. It makes rendering and flushing parallel.
  73:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *
  74:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      * 3. Double buffering
  75:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *      Set 2 screens sized buffers and set disp_drv.full_refresh = 1.
  76:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *      This way LVGL will always provide the whole rendered screen in `flush_cb`
  77:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      *      and you only need to change the frame buffer's address.
  78:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****      */
  79:Middlewares/LVGL/GUI/porting/lv_port_disp.c **** 	 
  80:Middlewares/LVGL/GUI/porting/lv_port_disp.c **** 	static lv_disp_drv_t disp_drv;                         /*Descriptor of a display driver*/
  81:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****     lv_disp_drv_init(&disp_drv);                    /*Basic initialization*/
  82:Middlewares/LVGL/GUI/porting/lv_port_disp.c **** 
  83:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****     /*Set up the functions to access to your display*/
  84:Middlewares/LVGL/GUI/porting/lv_port_disp.c **** 
  85:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****     /*Set the resolution of the display*/
  86:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****     disp_drv.hor_res = LCD_W;
  87:Middlewares/LVGL/GUI/porting/lv_port_disp.c ****     disp_drv.ver_res = LCD_H;
