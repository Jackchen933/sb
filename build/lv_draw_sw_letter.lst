 101:Middlewares/LVGL/GUI/lvgl/src/draw/sw/lv_draw_sw_letter.c ****         /*Add warning if the dsc is not found
 102:Middlewares/LVGL/GUI/lvgl/src/draw/sw/lv_draw_sw_letter.c ****          *but do not print warning for non printable ASCII chars (e.g. '\n')*/
 103:Middlewares/LVGL/GUI/lvgl/src/draw/sw/lv_draw_sw_letter.c ****         if(letter >= 0x20 &&
 104:Middlewares/LVGL/GUI/lvgl/src/draw/sw/lv_draw_sw_letter.c ****            letter != 0xf8ff && /*LV_SYMBOL_DUMMY*/
