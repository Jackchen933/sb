1588:BSP/MPU6050/eMPL/inv_mpu.c **** /**
1589:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Turn specific sensors on/off.
1590:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @e sensors can contain a combination of the following flags:
1591:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_X_GYRO, INV_Y_GYRO, INV_Z_GYRO
1592:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_XYZ_GYRO
1593:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_XYZ_ACCEL
1594:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_XYZ_COMPASS
1595:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[in]  sensors    Mask of sensors to wake.
1596:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
1597:BSP/MPU6050/eMPL/inv_mpu.c ****  */
1598:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_set_sensors(unsigned char sensors)
1599:BSP/MPU6050/eMPL/inv_mpu.c **** {
1600:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char data;
1601:BSP/MPU6050/eMPL/inv_mpu.c **** #ifdef AK89xx_SECONDARY
1602:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char user_ctrl;
1603:BSP/MPU6050/eMPL/inv_mpu.c **** #endif
1604:BSP/MPU6050/eMPL/inv_mpu.c **** 
1605:BSP/MPU6050/eMPL/inv_mpu.c ****     if (sensors & INV_XYZ_GYRO)
1606:BSP/MPU6050/eMPL/inv_mpu.c ****         data = INV_CLK_PLL;
1607:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (sensors)
1608:BSP/MPU6050/eMPL/inv_mpu.c ****         data = 0;
1609:BSP/MPU6050/eMPL/inv_mpu.c ****     else
1610:BSP/MPU6050/eMPL/inv_mpu.c ****         data = BIT_SLEEP;
1611:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_write(st.hw->addr, st.reg->pwr_mgmt_1, 1, &data)) {
1612:BSP/MPU6050/eMPL/inv_mpu.c ****         st.chip_cfg.sensors = 0;
1613:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1614:BSP/MPU6050/eMPL/inv_mpu.c ****     }
1615:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.clk_src = data & ~BIT_SLEEP;
1616:BSP/MPU6050/eMPL/inv_mpu.c **** 
1617:BSP/MPU6050/eMPL/inv_mpu.c ****     data = 0;
1618:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!(sensors & INV_X_GYRO))
1619:BSP/MPU6050/eMPL/inv_mpu.c ****         data |= BIT_STBY_XG;
1620:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!(sensors & INV_Y_GYRO))
1621:BSP/MPU6050/eMPL/inv_mpu.c ****         data |= BIT_STBY_YG;
1622:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!(sensors & INV_Z_GYRO))
1623:BSP/MPU6050/eMPL/inv_mpu.c ****         data |= BIT_STBY_ZG;
1624:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!(sensors & INV_XYZ_ACCEL))
1625:BSP/MPU6050/eMPL/inv_mpu.c ****         data |= BIT_STBY_XYZA;
1626:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_write(st.hw->addr, st.reg->pwr_mgmt_2, 1, &data)) {
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc50WfpY.s 			page 30


1627:BSP/MPU6050/eMPL/inv_mpu.c ****         st.chip_cfg.sensors = 0;
1628:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1629:BSP/MPU6050/eMPL/inv_mpu.c ****     }
1630:BSP/MPU6050/eMPL/inv_mpu.c **** 
1631:BSP/MPU6050/eMPL/inv_mpu.c ****     if (sensors && (sensors != INV_XYZ_ACCEL))
1632:BSP/MPU6050/eMPL/inv_mpu.c ****         /* Latched interrupts only used in LP accel mode. */
1633:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_int_latched(0);
1634:BSP/MPU6050/eMPL/inv_mpu.c **** 
1635:BSP/MPU6050/eMPL/inv_mpu.c **** #ifdef AK89xx_SECONDARY
1636:BSP/MPU6050/eMPL/inv_mpu.c **** #ifdef AK89xx_BYPASS
1637:BSP/MPU6050/eMPL/inv_mpu.c ****     if (sensors & INV_XYZ_COMPASS)
1638:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_bypass(1);
1639:BSP/MPU6050/eMPL/inv_mpu.c ****     else
1640:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_bypass(0);
1641:BSP/MPU6050/eMPL/inv_mpu.c **** #else
1642:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_read(st.hw->addr, st.reg->user_ctrl, 1, &user_ctrl))
1643:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1644:BSP/MPU6050/eMPL/inv_mpu.c ****     /* Handle AKM power management. */
1645:BSP/MPU6050/eMPL/inv_mpu.c ****     if (sensors & INV_XYZ_COMPASS) {
1646:BSP/MPU6050/eMPL/inv_mpu.c ****         data = AKM_SINGLE_MEASUREMENT;
1647:BSP/MPU6050/eMPL/inv_mpu.c ****         user_ctrl |= BIT_AUX_IF_EN;
1648:BSP/MPU6050/eMPL/inv_mpu.c ****     } else {
1649:BSP/MPU6050/eMPL/inv_mpu.c ****         data = AKM_POWER_DOWN;
