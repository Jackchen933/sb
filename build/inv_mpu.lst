1297:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1298:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FILTER_42HZ:
1299:BSP/MPU6050/eMPL/inv_mpu.c ****         lpf[0] = 42;
1300:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1301:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FILTER_20HZ:
1302:BSP/MPU6050/eMPL/inv_mpu.c ****         lpf[0] = 20;
1303:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1304:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FILTER_10HZ:
1305:BSP/MPU6050/eMPL/inv_mpu.c ****         lpf[0] = 10;
1306:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1307:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FILTER_5HZ:
1308:BSP/MPU6050/eMPL/inv_mpu.c ****         lpf[0] = 5;
1309:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1310:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FILTER_256HZ_NOLPF2:
1311:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FILTER_2100HZ_NOLPF:
1312:BSP/MPU6050/eMPL/inv_mpu.c ****     default:
1313:BSP/MPU6050/eMPL/inv_mpu.c ****         lpf[0] = 0;
1314:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1315:BSP/MPU6050/eMPL/inv_mpu.c ****     }
1316:BSP/MPU6050/eMPL/inv_mpu.c ****     return 0;
1317:BSP/MPU6050/eMPL/inv_mpu.c **** }
