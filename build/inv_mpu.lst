1656:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_write(st.hw->addr, st.reg->s1_do, 1, &data))
1657:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1658:BSP/MPU6050/eMPL/inv_mpu.c ****     /* Enable/disable I2C master mode. */
1659:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_write(st.hw->addr, st.reg->user_ctrl, 1, &user_ctrl))
1660:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1661:BSP/MPU6050/eMPL/inv_mpu.c **** #endif
1662:BSP/MPU6050/eMPL/inv_mpu.c **** #endif
1663:BSP/MPU6050/eMPL/inv_mpu.c **** 
1664:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.sensors = sensors;
1665:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.lp_accel_mode = 0;
1666:BSP/MPU6050/eMPL/inv_mpu.c ****     delay_ms(50);
1667:BSP/MPU6050/eMPL/inv_mpu.c ****     return 0;
