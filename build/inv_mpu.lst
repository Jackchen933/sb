1431:BSP/MPU6050/eMPL/inv_mpu.c **** /**
1432:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Set compass sampling rate.
1433:BSP/MPU6050/eMPL/inv_mpu.c ****  *  The compass on the auxiliary I2C bus is read by the MPU hardware at a
1434:BSP/MPU6050/eMPL/inv_mpu.c ****  *  maximum of 100Hz. The actual rate can be set to a fraction of the gyro
1435:BSP/MPU6050/eMPL/inv_mpu.c ****  *  sampling rate.
1436:BSP/MPU6050/eMPL/inv_mpu.c ****  *
1437:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n WARNING: The new rate may be different than what was requested. Call
1438:BSP/MPU6050/eMPL/inv_mpu.c ****  *  mpu_get_compass_sample_rate to check the actual setting.
1439:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[in]  rate    Desired compass sampling rate (Hz).
1440:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
1441:BSP/MPU6050/eMPL/inv_mpu.c ****  */
1442:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_set_compass_sample_rate(unsigned short rate)
1443:BSP/MPU6050/eMPL/inv_mpu.c **** {
1444:BSP/MPU6050/eMPL/inv_mpu.c **** #ifdef AK89xx_SECONDARY
1445:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char div;
1446:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!rate || rate > st.chip_cfg.sample_rate || rate > MAX_COMPASS_SAMPLE_RATE)
1447:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1448:BSP/MPU6050/eMPL/inv_mpu.c **** 
1449:BSP/MPU6050/eMPL/inv_mpu.c ****     div = st.chip_cfg.sample_rate / rate - 1;
1450:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_write(st.hw->addr, st.reg->s4_ctrl, 1, &div))
1451:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1452:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.compass_sample_rate = st.chip_cfg.sample_rate / (div + 1);
1453:BSP/MPU6050/eMPL/inv_mpu.c ****     return 0;
1454:BSP/MPU6050/eMPL/inv_mpu.c **** #else
1455:BSP/MPU6050/eMPL/inv_mpu.c ****     return -1;
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc50WfpY.s 			page 27


1456:BSP/MPU6050/eMPL/inv_mpu.c **** #endif
1457:BSP/MPU6050/eMPL/inv_mpu.c **** }
