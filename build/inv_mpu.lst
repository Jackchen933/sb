  51:BSP/MPU6050/eMPL/inv_mpu.c **** //#include "msp430_interrupt.h"
  52:BSP/MPU6050/eMPL/inv_mpu.c **** 
  53:BSP/MPU6050/eMPL/inv_mpu.c **** #define i2c_write   MPU_Write_Len
  54:BSP/MPU6050/eMPL/inv_mpu.c **** #define i2c_read    MPU_Read_Len
  55:BSP/MPU6050/eMPL/inv_mpu.c **** #define delay_ms    delay_ms
  56:BSP/MPU6050/eMPL/inv_mpu.c **** #define get_ms      mget_ms
  57:BSP/MPU6050/eMPL/inv_mpu.c **** //static inline int reg_int_cb(struct int_param_s *int_param)
  58:BSP/MPU6050/eMPL/inv_mpu.c **** //{
  59:BSP/MPU6050/eMPL/inv_mpu.c **** //    return msp430_reg_int_cb(int_param->cb, int_param->pin, int_param->lp_exit,
