 679:BSP/MPU6050/eMPL/inv_mpu.c **** /**
 680:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Enable/disable data ready interrupt.
 681:BSP/MPU6050/eMPL/inv_mpu.c ****  *  If the DMP is on, the DMP interrupt is enabled. Otherwise, the data ready
 682:BSP/MPU6050/eMPL/inv_mpu.c ****  *  interrupt is used.
 683:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[in]  enable      1 to enable interrupt.
 684:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
 685:BSP/MPU6050/eMPL/inv_mpu.c ****  */
 686:BSP/MPU6050/eMPL/inv_mpu.c **** static int set_int_enable(unsigned char enable)
 687:BSP/MPU6050/eMPL/inv_mpu.c **** {
 688:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char tmp;
 689:BSP/MPU6050/eMPL/inv_mpu.c **** 
 690:BSP/MPU6050/eMPL/inv_mpu.c ****     if (st.chip_cfg.dmp_on) {
 691:BSP/MPU6050/eMPL/inv_mpu.c ****         if (enable)
 692:BSP/MPU6050/eMPL/inv_mpu.c ****             tmp = BIT_DMP_INT_EN;
 693:BSP/MPU6050/eMPL/inv_mpu.c ****         else
 694:BSP/MPU6050/eMPL/inv_mpu.c ****             tmp = 0x00;
 695:BSP/MPU6050/eMPL/inv_mpu.c ****         if (i2c_write(st.hw->addr, st.reg->int_enable, 1, &tmp))
 696:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
 697:BSP/MPU6050/eMPL/inv_mpu.c ****         st.chip_cfg.int_enable = tmp;
 698:BSP/MPU6050/eMPL/inv_mpu.c ****     } else {
 699:BSP/MPU6050/eMPL/inv_mpu.c ****         if (!st.chip_cfg.sensors)
 700:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
 701:BSP/MPU6050/eMPL/inv_mpu.c ****         if (enable && st.chip_cfg.int_enable)
 702:BSP/MPU6050/eMPL/inv_mpu.c ****             return 0;
 703:BSP/MPU6050/eMPL/inv_mpu.c ****         if (enable)
 704:BSP/MPU6050/eMPL/inv_mpu.c ****             tmp = BIT_DATA_RDY_EN;
 705:BSP/MPU6050/eMPL/inv_mpu.c ****         else
 706:BSP/MPU6050/eMPL/inv_mpu.c ****             tmp = 0x00;
 707:BSP/MPU6050/eMPL/inv_mpu.c ****         if (i2c_write(st.hw->addr, st.reg->int_enable, 1, &tmp))
 708:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
 709:BSP/MPU6050/eMPL/inv_mpu.c ****         st.chip_cfg.int_enable = tmp;
 710:BSP/MPU6050/eMPL/inv_mpu.c ****     }
 711:BSP/MPU6050/eMPL/inv_mpu.c ****     return 0;
 712:BSP/MPU6050/eMPL/inv_mpu.c **** }
 713:BSP/MPU6050/eMPL/inv_mpu.c **** 
 714:BSP/MPU6050/eMPL/inv_mpu.c **** /**
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc50WfpY.s 			page 14


 715:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Register dump for testing.
 716:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
 717:BSP/MPU6050/eMPL/inv_mpu.c ****  */
 718:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_reg_dump(void)
 719:BSP/MPU6050/eMPL/inv_mpu.c **** {
 720:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char ii;
 721:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char data;
 722:BSP/MPU6050/eMPL/inv_mpu.c **** 
 723:BSP/MPU6050/eMPL/inv_mpu.c ****     for (ii = 0; ii < st.hw->num_reg; ii++) {
 724:BSP/MPU6050/eMPL/inv_mpu.c ****         if (ii == st.reg->fifo_r_w || ii == st.reg->mem_r_w)
 725:BSP/MPU6050/eMPL/inv_mpu.c ****             continue;
 726:BSP/MPU6050/eMPL/inv_mpu.c ****         if (i2c_read(st.hw->addr, ii, 1, &data))
 727:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
