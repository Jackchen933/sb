 749:BSP/MPU6050/eMPL/inv_mpu.c **** /**
 750:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Initialize hardware.
 751:BSP/MPU6050/eMPL/inv_mpu.c ****  *  Initial configuration:\n
 752:BSP/MPU6050/eMPL/inv_mpu.c ****  *  Gyro FSR: +/- 2000DPS\n
 753:BSP/MPU6050/eMPL/inv_mpu.c ****  *  Accel FSR +/- 2G\n
 754:BSP/MPU6050/eMPL/inv_mpu.c ****  *  DLPF: 42Hz\n
 755:BSP/MPU6050/eMPL/inv_mpu.c ****  *  FIFO rate: 50Hz\n
 756:BSP/MPU6050/eMPL/inv_mpu.c ****  *  Clock source: Gyro PLL\n
 757:BSP/MPU6050/eMPL/inv_mpu.c ****  *  FIFO: Disabled.\n
 758:BSP/MPU6050/eMPL/inv_mpu.c ****  *  Data ready interrupt: Disabled, active low, unlatched.
 759:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[in]  int_param   Platform-specific parameters to interrupt API.
 760:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
 761:BSP/MPU6050/eMPL/inv_mpu.c ****  */
 762:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_init(void)
 763:BSP/MPU6050/eMPL/inv_mpu.c **** {
 764:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char data[6], rev;
 765:BSP/MPU6050/eMPL/inv_mpu.c **** 
 766:BSP/MPU6050/eMPL/inv_mpu.c ****     /* Reset device. */
