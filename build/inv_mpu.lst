 792:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
 793:BSP/MPU6050/eMPL/inv_mpu.c ****         }
 794:BSP/MPU6050/eMPL/inv_mpu.c ****     } else {
 795:BSP/MPU6050/eMPL/inv_mpu.c ****         if (i2c_read(st.hw->addr, st.reg->prod_id, 1, data))
 796:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
 797:BSP/MPU6050/eMPL/inv_mpu.c ****         rev = data[0] & 0x0F;
 798:BSP/MPU6050/eMPL/inv_mpu.c ****         if (!rev) {
