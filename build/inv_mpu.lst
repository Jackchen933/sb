 819:BSP/MPU6050/eMPL/inv_mpu.c ****     /* MPU6500 shares 4kB of memory between the DMP and the FIFO. Since the
 820:BSP/MPU6050/eMPL/inv_mpu.c ****      * first 3kB are needed by the DMP, we'll use the last 1kB for the FIFO.
 821:BSP/MPU6050/eMPL/inv_mpu.c ****      */
 822:BSP/MPU6050/eMPL/inv_mpu.c ****     data[0] = BIT_FIFO_SIZE_1024 | 0x8;
