1465:BSP/MPU6050/eMPL/inv_mpu.c **** {
1466:BSP/MPU6050/eMPL/inv_mpu.c ****     switch (st.chip_cfg.gyro_fsr) {
1467:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FSR_250DPS:
1468:BSP/MPU6050/eMPL/inv_mpu.c ****         sens[0] = 131.f;
1469:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1470:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FSR_500DPS:
1471:BSP/MPU6050/eMPL/inv_mpu.c ****         sens[0] = 65.5f;
1472:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1473:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FSR_1000DPS:
1474:BSP/MPU6050/eMPL/inv_mpu.c ****         sens[0] = 32.8f;
1475:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1476:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FSR_2000DPS:
1477:BSP/MPU6050/eMPL/inv_mpu.c ****         sens[0] = 16.4f;
1478:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1479:BSP/MPU6050/eMPL/inv_mpu.c ****     default:
1480:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1481:BSP/MPU6050/eMPL/inv_mpu.c ****     }
1482:BSP/MPU6050/eMPL/inv_mpu.c ****     return 0;
1483:BSP/MPU6050/eMPL/inv_mpu.c **** }
1484:BSP/MPU6050/eMPL/inv_mpu.c **** 
1485:BSP/MPU6050/eMPL/inv_mpu.c **** /**
1486:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Get accel sensitivity scale factor.
1487:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[out] sens    Conversion from hardware units to g's.
