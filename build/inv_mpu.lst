 782:BSP/MPU6050/eMPL/inv_mpu.c ****         (data[1] & 0x01);
 783:BSP/MPU6050/eMPL/inv_mpu.c **** 
 784:BSP/MPU6050/eMPL/inv_mpu.c ****     if (rev) {
 785:BSP/MPU6050/eMPL/inv_mpu.c ****         /* Congrats, these parts are better. */
 786:BSP/MPU6050/eMPL/inv_mpu.c ****         if (rev == 1)
 787:BSP/MPU6050/eMPL/inv_mpu.c ****             st.chip_cfg.accel_half = 1;
 788:BSP/MPU6050/eMPL/inv_mpu.c ****         else if (rev == 2)
