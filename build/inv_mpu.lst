 878:BSP/MPU6050/eMPL/inv_mpu.c **** /**
 879:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Enter low-power accel-only mode.
 880:BSP/MPU6050/eMPL/inv_mpu.c ****  *  In low-power accel mode, the chip goes to sleep and only wakes up to sample
 881:BSP/MPU6050/eMPL/inv_mpu.c ****  *  the accelerometer at one of the following frequencies:
 882:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n MPU6050: 1.25Hz, 5Hz, 20Hz, 40Hz
 883:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n MPU6500: 1.25Hz, 2.5Hz, 5Hz, 10Hz, 20Hz, 40Hz, 80Hz, 160Hz, 320Hz, 640Hz
 884:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n If the requested rate is not one listed above, the device will be set to
 885:BSP/MPU6050/eMPL/inv_mpu.c ****  *  the next highest rate. Requesting a rate above the maximum supported
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc50WfpY.s 			page 17


 886:BSP/MPU6050/eMPL/inv_mpu.c ****  *  frequency will result in an error.
 887:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n To select a fractional wake-up frequency, round down the value passed to
 888:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @e rate.
 889:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[in]  rate        Minimum sampling rate, or zero to disable LP
 890:BSP/MPU6050/eMPL/inv_mpu.c ****  *                          accel mode.
 891:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
 892:BSP/MPU6050/eMPL/inv_mpu.c ****  */
 893:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_lp_accel_mode(unsigned char rate)
 894:BSP/MPU6050/eMPL/inv_mpu.c **** {
 895:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char tmp[2];
 896:BSP/MPU6050/eMPL/inv_mpu.c **** 
 897:BSP/MPU6050/eMPL/inv_mpu.c ****     if (rate > 40)
 898:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
 899:BSP/MPU6050/eMPL/inv_mpu.c **** 
 900:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!rate) {
 901:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_int_latched(0);
 902:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = 0;
 903:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[1] = BIT_STBY_XYZG;
 904:BSP/MPU6050/eMPL/inv_mpu.c ****         if (i2c_write(st.hw->addr, st.reg->pwr_mgmt_1, 2, tmp))
 905:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
 906:BSP/MPU6050/eMPL/inv_mpu.c ****         st.chip_cfg.lp_accel_mode = 0;
 907:BSP/MPU6050/eMPL/inv_mpu.c ****         return 0;
 908:BSP/MPU6050/eMPL/inv_mpu.c ****     }
 909:BSP/MPU6050/eMPL/inv_mpu.c ****     /* For LP accel, we automatically configure the hardware to produce latched
 910:BSP/MPU6050/eMPL/inv_mpu.c ****      * interrupts. In LP accel mode, the hardware cycles into sleep mode before
 911:BSP/MPU6050/eMPL/inv_mpu.c ****      * it gets a chance to deassert the interrupt pin; therefore, we shift this
 912:BSP/MPU6050/eMPL/inv_mpu.c ****      * responsibility over to the MCU.
 913:BSP/MPU6050/eMPL/inv_mpu.c ****      *
 914:BSP/MPU6050/eMPL/inv_mpu.c ****      * Any register read will clear the interrupt.
 915:BSP/MPU6050/eMPL/inv_mpu.c ****      */
 916:BSP/MPU6050/eMPL/inv_mpu.c ****     mpu_set_int_latched(1);
 917:BSP/MPU6050/eMPL/inv_mpu.c **** #if defined MPU6050
 918:BSP/MPU6050/eMPL/inv_mpu.c ****     //tmp[0] = BIT_LPA_CYCLE;
 919:BSP/MPU6050/eMPL/inv_mpu.c **** 		tmp[0] = 0x28;
 920:BSP/MPU6050/eMPL/inv_mpu.c ****     if (rate == 1) {
 921:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[1] = INV_LPA_1_25HZ;
 922:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_lpf(5);
 923:BSP/MPU6050/eMPL/inv_mpu.c ****     } else if (rate <= 5) {
 924:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[1] = INV_LPA_5HZ;
 925:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_lpf(5);
 926:BSP/MPU6050/eMPL/inv_mpu.c ****     } else if (rate <= 20) {
 927:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[1] = INV_LPA_20HZ;
 928:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_lpf(10);
 929:BSP/MPU6050/eMPL/inv_mpu.c ****     } else {
 930:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[1] = INV_LPA_40HZ;
 931:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_lpf(20);
 932:BSP/MPU6050/eMPL/inv_mpu.c ****     }
 933:BSP/MPU6050/eMPL/inv_mpu.c ****     tmp[1] = (tmp[1] << 6) | BIT_STBY_XYZG;
 934:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_write(st.hw->addr, st.reg->pwr_mgmt_1, 2, tmp))
 935:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
 936:BSP/MPU6050/eMPL/inv_mpu.c **** #elif defined MPU6500
 937:BSP/MPU6050/eMPL/inv_mpu.c ****     /* Set wake frequency. */
 938:BSP/MPU6050/eMPL/inv_mpu.c ****     if (rate == 1)
 939:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_1_25HZ;
 940:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (rate == 2)
 941:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_2_5HZ;
 942:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (rate <= 5)
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc50WfpY.s 			page 18


 943:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_5HZ;
 944:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (rate <= 10)
 945:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_10HZ;
 946:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (rate <= 20)
 947:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_20HZ;
 948:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (rate <= 40)
 949:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_40HZ;
 950:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (rate <= 80)
 951:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_80HZ;
 952:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (rate <= 160)
 953:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_160HZ;
 954:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (rate <= 320)
 955:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_320HZ;
 956:BSP/MPU6050/eMPL/inv_mpu.c ****     else
 957:BSP/MPU6050/eMPL/inv_mpu.c ****         tmp[0] = INV_LPA_640HZ;
 958:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_write(st.hw->addr, st.reg->lp_accel_odr, 1, tmp))
