2908:BSP/MPU6050/eMPL/inv_mpu.c ****     const signed char *mtx)
2909:BSP/MPU6050/eMPL/inv_mpu.c **** {
2910:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned short scalar; 
2911:BSP/MPU6050/eMPL/inv_mpu.c ****     /*
2912:BSP/MPU6050/eMPL/inv_mpu.c ****        XYZ  010_001_000 Identity Matrix
2913:BSP/MPU6050/eMPL/inv_mpu.c ****        XZY  001_010_000
2914:BSP/MPU6050/eMPL/inv_mpu.c ****        YXZ  010_000_001
2915:BSP/MPU6050/eMPL/inv_mpu.c ****        YZX  000_010_001
2916:BSP/MPU6050/eMPL/inv_mpu.c ****        ZXY  001_000_010
2917:BSP/MPU6050/eMPL/inv_mpu.c ****        ZYX  000_001_010
2918:BSP/MPU6050/eMPL/inv_mpu.c ****      */
2919:BSP/MPU6050/eMPL/inv_mpu.c **** 
2920:BSP/MPU6050/eMPL/inv_mpu.c ****     scalar = inv_row_2_scale(mtx);
2921:BSP/MPU6050/eMPL/inv_mpu.c ****     scalar |= inv_row_2_scale(mtx + 3) << 3;
2922:BSP/MPU6050/eMPL/inv_mpu.c ****     scalar |= inv_row_2_scale(mtx + 6) << 6;
2923:BSP/MPU6050/eMPL/inv_mpu.c **** 
2924:BSP/MPU6050/eMPL/inv_mpu.c **** 
2925:BSP/MPU6050/eMPL/inv_mpu.c ****     return scalar;
2926:BSP/MPU6050/eMPL/inv_mpu.c **** }
