1493:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FSR_2G:
1494:BSP/MPU6050/eMPL/inv_mpu.c ****         sens[0] = 16384;
1495:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1496:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FSR_4G:
1497:BSP/MPU6050/eMPL/inv_mpu.c ****         sens[0] = 8092;
1498:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1499:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FSR_8G:
1500:BSP/MPU6050/eMPL/inv_mpu.c ****         sens[0] = 4096;
1501:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1502:BSP/MPU6050/eMPL/inv_mpu.c ****     case INV_FSR_16G:
1503:BSP/MPU6050/eMPL/inv_mpu.c ****         sens[0] = 2048;
1504:BSP/MPU6050/eMPL/inv_mpu.c ****         break;
1505:BSP/MPU6050/eMPL/inv_mpu.c ****     default:
