 772:BSP/MPU6050/eMPL/inv_mpu.c ****     /* Wake up chip. */
 773:BSP/MPU6050/eMPL/inv_mpu.c ****     data[0] = 0x00;
 774:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_write(st.hw->addr, st.reg->pwr_mgmt_1, 1, data))
 775:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
 776:BSP/MPU6050/eMPL/inv_mpu.c **** 
 777:BSP/MPU6050/eMPL/inv_mpu.c **** #if defined MPU6050
 778:BSP/MPU6050/eMPL/inv_mpu.c ****     /* Check product revision. */
