2154:BSP/MPU6050/eMPL/inv_mpu.c **** 
2155:BSP/MPU6050/eMPL/inv_mpu.c **** /**
2156:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Trigger gyro/accel/compass self-test.
2157:BSP/MPU6050/eMPL/inv_mpu.c ****  *  On success/error, the self-test returns a mask representing the sensor(s)
2158:BSP/MPU6050/eMPL/inv_mpu.c ****  *  that failed. For each bit, a one (1) represents a "pass" case; conversely,
2159:BSP/MPU6050/eMPL/inv_mpu.c ****  *  a zero (0) indicates a failure.
2160:BSP/MPU6050/eMPL/inv_mpu.c ****  *
2161:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n The mask is defined as follows:
2162:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n Bit 0:   Gyro.
2163:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n Bit 1:   Accel.
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc50WfpY.s 			page 172


2164:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n Bit 2:   Compass.
2165:BSP/MPU6050/eMPL/inv_mpu.c ****  *
2166:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n Currently, the hardware self-test is unsupported for MPU6500. However,
2167:BSP/MPU6050/eMPL/inv_mpu.c ****  *  this function can still be used to obtain the accel and gyro biases.
2168:BSP/MPU6050/eMPL/inv_mpu.c ****  *
2169:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n This function must be called with the device either face-up or face-down
2170:BSP/MPU6050/eMPL/inv_mpu.c ****  *  (z-axis is parallel to gravity).
2171:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[out] gyro        Gyro biases in q16 format.
2172:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[out] accel       Accel biases (if applicable) in q16 format.
2173:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     Result mask (see above).
2174:BSP/MPU6050/eMPL/inv_mpu.c ****  */
2175:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_run_self_test(long *gyro, long *accel)
2176:BSP/MPU6050/eMPL/inv_mpu.c **** {
2177:BSP/MPU6050/eMPL/inv_mpu.c **** #ifdef MPU6050
2178:BSP/MPU6050/eMPL/inv_mpu.c ****     const unsigned char tries = 2;
2179:BSP/MPU6050/eMPL/inv_mpu.c ****     long gyro_st[3], accel_st[3];
2180:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char accel_result, gyro_result;
2181:BSP/MPU6050/eMPL/inv_mpu.c **** #ifdef AK89xx_SECONDARY
2182:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char compass_result;
2183:BSP/MPU6050/eMPL/inv_mpu.c **** #endif
2184:BSP/MPU6050/eMPL/inv_mpu.c ****     int ii;
2185:BSP/MPU6050/eMPL/inv_mpu.c **** #endif
2186:BSP/MPU6050/eMPL/inv_mpu.c ****     int result;
2187:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char accel_fsr, fifo_sensors, sensors_on;
2188:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned short gyro_fsr, sample_rate, lpf;
2189:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char dmp_was_on;
2190:BSP/MPU6050/eMPL/inv_mpu.c **** 
2191:BSP/MPU6050/eMPL/inv_mpu.c ****     if (st.chip_cfg.dmp_on) {
2192:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_dmp_state(0);
2193:BSP/MPU6050/eMPL/inv_mpu.c ****         dmp_was_on = 1;
2194:BSP/MPU6050/eMPL/inv_mpu.c ****     } else
2195:BSP/MPU6050/eMPL/inv_mpu.c ****         dmp_was_on = 0;
2196:BSP/MPU6050/eMPL/inv_mpu.c **** 
2197:BSP/MPU6050/eMPL/inv_mpu.c ****     /* Get initial settings. */
2198:BSP/MPU6050/eMPL/inv_mpu.c ****     mpu_get_gyro_fsr(&gyro_fsr);
2199:BSP/MPU6050/eMPL/inv_mpu.c ****     mpu_get_accel_fsr(&accel_fsr);
2200:BSP/MPU6050/eMPL/inv_mpu.c ****     mpu_get_lpf(&lpf);
2201:BSP/MPU6050/eMPL/inv_mpu.c ****     mpu_get_sample_rate(&sample_rate);
2202:BSP/MPU6050/eMPL/inv_mpu.c ****     sensors_on = st.chip_cfg.sensors;
2203:BSP/MPU6050/eMPL/inv_mpu.c ****     mpu_get_fifo_config(&fifo_sensors);
2204:BSP/MPU6050/eMPL/inv_mpu.c **** 
2205:BSP/MPU6050/eMPL/inv_mpu.c ****     /* For older chips, the self-test will be different. */
2206:BSP/MPU6050/eMPL/inv_mpu.c **** #if defined MPU6050
2207:BSP/MPU6050/eMPL/inv_mpu.c ****     for (ii = 0; ii < tries; ii++)
2208:BSP/MPU6050/eMPL/inv_mpu.c ****         if (!get_st_biases(gyro, accel, 0))
2209:BSP/MPU6050/eMPL/inv_mpu.c ****             break;
2210:BSP/MPU6050/eMPL/inv_mpu.c ****     if (ii == tries) {
2211:BSP/MPU6050/eMPL/inv_mpu.c ****         /* If we reach this point, we most likely encountered an I2C error.
2212:BSP/MPU6050/eMPL/inv_mpu.c ****          * We'll just report an error for all three sensors.
2213:BSP/MPU6050/eMPL/inv_mpu.c ****          */
2214:BSP/MPU6050/eMPL/inv_mpu.c ****         result = 0;
2215:BSP/MPU6050/eMPL/inv_mpu.c ****         goto restore;
2216:BSP/MPU6050/eMPL/inv_mpu.c ****     }
2217:BSP/MPU6050/eMPL/inv_mpu.c ****     for (ii = 0; ii < tries; ii++)
2218:BSP/MPU6050/eMPL/inv_mpu.c ****         if (!get_st_biases(gyro_st, accel_st, 1))
2219:BSP/MPU6050/eMPL/inv_mpu.c ****             break;
2220:BSP/MPU6050/eMPL/inv_mpu.c ****     if (ii == tries) {
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc50WfpY.s 			page 173


2221:BSP/MPU6050/eMPL/inv_mpu.c ****         /* Again, probably an I2C error. */
2222:BSP/MPU6050/eMPL/inv_mpu.c ****         result = 0;
2223:BSP/MPU6050/eMPL/inv_mpu.c ****         goto restore;
2224:BSP/MPU6050/eMPL/inv_mpu.c ****     }
2225:BSP/MPU6050/eMPL/inv_mpu.c ****     accel_result = accel_self_test(accel, accel_st);
2226:BSP/MPU6050/eMPL/inv_mpu.c ****     gyro_result = gyro_self_test(gyro, gyro_st);
2227:BSP/MPU6050/eMPL/inv_mpu.c **** 
2228:BSP/MPU6050/eMPL/inv_mpu.c ****     result = 0;
2229:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!gyro_result)
2230:BSP/MPU6050/eMPL/inv_mpu.c ****         result |= 0x01;
2231:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!accel_result)
2232:BSP/MPU6050/eMPL/inv_mpu.c ****         result |= 0x02;
2233:BSP/MPU6050/eMPL/inv_mpu.c **** 
2234:BSP/MPU6050/eMPL/inv_mpu.c **** #ifdef AK89xx_SECONDARY
2235:BSP/MPU6050/eMPL/inv_mpu.c ****     compass_result = compass_self_test();
2236:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!compass_result)
2237:BSP/MPU6050/eMPL/inv_mpu.c ****         result |= 0x04;
2238:BSP/MPU6050/eMPL/inv_mpu.c **** #endif
2239:BSP/MPU6050/eMPL/inv_mpu.c **** restore:
2240:BSP/MPU6050/eMPL/inv_mpu.c **** #elif defined MPU6500
2241:BSP/MPU6050/eMPL/inv_mpu.c ****     /* For now, this function will return a "pass" result for all three sensors
2242:BSP/MPU6050/eMPL/inv_mpu.c ****      * for compatibility with current test applications.
2243:BSP/MPU6050/eMPL/inv_mpu.c ****      */
2244:BSP/MPU6050/eMPL/inv_mpu.c ****     get_st_biases(gyro, accel, 0);
2245:BSP/MPU6050/eMPL/inv_mpu.c ****     result = 0x7;
2246:BSP/MPU6050/eMPL/inv_mpu.c **** #endif
2247:BSP/MPU6050/eMPL/inv_mpu.c ****     /* Set to invalid values to ensure no I2C writes are skipped. */
2248:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.gyro_fsr = 0xFF;
2249:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.accel_fsr = 0xFF;
2250:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.lpf = 0xFF;
2251:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.sample_rate = 0xFFFF;
2252:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.sensors = 0xFF;
