 743:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
 744:BSP/MPU6050/eMPL/inv_mpu.c ****     if (reg >= st.hw->num_reg)
 745:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
