1528:BSP/MPU6050/eMPL/inv_mpu.c **** /**
1529:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Select which sensors are pushed to FIFO.
1530:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @e sensors can contain a combination of the following flags:
1531:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_X_GYRO, INV_Y_GYRO, INV_Z_GYRO
1532:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_XYZ_GYRO
1533:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_XYZ_ACCEL
1534:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[in]  sensors Mask of sensors to push to FIFO.
1535:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
1536:BSP/MPU6050/eMPL/inv_mpu.c ****  */
1537:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_configure_fifo(unsigned char sensors)
1538:BSP/MPU6050/eMPL/inv_mpu.c **** {
1539:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char prev;
1540:BSP/MPU6050/eMPL/inv_mpu.c ****     int result = 0;
1541:BSP/MPU6050/eMPL/inv_mpu.c **** 
1542:BSP/MPU6050/eMPL/inv_mpu.c ****     /* Compass data isn't going into the FIFO. Stop trying. */
1543:BSP/MPU6050/eMPL/inv_mpu.c ****     sensors &= ~INV_XYZ_COMPASS;
1544:BSP/MPU6050/eMPL/inv_mpu.c **** 
1545:BSP/MPU6050/eMPL/inv_mpu.c ****     if (st.chip_cfg.dmp_on)
1546:BSP/MPU6050/eMPL/inv_mpu.c ****         return 0;
1547:BSP/MPU6050/eMPL/inv_mpu.c ****     else {
1548:BSP/MPU6050/eMPL/inv_mpu.c ****         if (!(st.chip_cfg.sensors))
1549:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
1550:BSP/MPU6050/eMPL/inv_mpu.c ****         prev = st.chip_cfg.fifo_enable;
1551:BSP/MPU6050/eMPL/inv_mpu.c ****         st.chip_cfg.fifo_enable = sensors & st.chip_cfg.sensors;
1552:BSP/MPU6050/eMPL/inv_mpu.c ****         if (st.chip_cfg.fifo_enable != sensors)
1553:BSP/MPU6050/eMPL/inv_mpu.c ****             /* You're not getting what you asked for. Some sensors are
1554:BSP/MPU6050/eMPL/inv_mpu.c ****              * asleep.
1555:BSP/MPU6050/eMPL/inv_mpu.c ****              */
1556:BSP/MPU6050/eMPL/inv_mpu.c ****             result = -1;
1557:BSP/MPU6050/eMPL/inv_mpu.c ****         else
1558:BSP/MPU6050/eMPL/inv_mpu.c ****             result = 0;
1559:BSP/MPU6050/eMPL/inv_mpu.c ****         if (sensors || st.chip_cfg.lp_accel_mode)
1560:BSP/MPU6050/eMPL/inv_mpu.c ****             set_int_enable(1);
1561:BSP/MPU6050/eMPL/inv_mpu.c ****         else
1562:BSP/MPU6050/eMPL/inv_mpu.c ****             set_int_enable(0);
1563:BSP/MPU6050/eMPL/inv_mpu.c ****         if (sensors) {
1564:BSP/MPU6050/eMPL/inv_mpu.c ****             if (mpu_reset_fifo()) {
1565:BSP/MPU6050/eMPL/inv_mpu.c ****                 st.chip_cfg.fifo_enable = prev;
1566:BSP/MPU6050/eMPL/inv_mpu.c ****                 return -1;
1567:BSP/MPU6050/eMPL/inv_mpu.c ****             }
1568:BSP/MPU6050/eMPL/inv_mpu.c ****         }
1569:BSP/MPU6050/eMPL/inv_mpu.c ****     }
