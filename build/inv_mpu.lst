1857:BSP/MPU6050/eMPL/inv_mpu.c ****         else
1858:BSP/MPU6050/eMPL/inv_mpu.c ****             tmp = 0;
1859:BSP/MPU6050/eMPL/inv_mpu.c ****         if (st.chip_cfg.latched_int)
