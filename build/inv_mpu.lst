 800:BSP/MPU6050/eMPL/inv_mpu.c ****                 "incompatible or an MPU3050.\n");
 801:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
 802:BSP/MPU6050/eMPL/inv_mpu.c ****         } else if (rev == 4) {
 803:BSP/MPU6050/eMPL/inv_mpu.c ****             log_i("Half sensitivity part found.\n");
 804:BSP/MPU6050/eMPL/inv_mpu.c ****             st.chip_cfg.accel_half = 1;
 805:BSP/MPU6050/eMPL/inv_mpu.c ****         } else
 806:BSP/MPU6050/eMPL/inv_mpu.c ****             st.chip_cfg.accel_half = 0;
 807:BSP/MPU6050/eMPL/inv_mpu.c ****     }
 808:BSP/MPU6050/eMPL/inv_mpu.c **** #elif defined MPU6500
 809:BSP/MPU6050/eMPL/inv_mpu.c **** #define MPU6500_MEM_REV_ADDR    (0x17)
 810:BSP/MPU6050/eMPL/inv_mpu.c ****     if (mpu_read_mem(MPU6500_MEM_REV_ADDR, 1, &rev))
 811:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
