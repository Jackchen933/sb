1686:BSP/MPU6050/eMPL/inv_mpu.c **** /**
1687:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Get one packet from the FIFO.
1688:BSP/MPU6050/eMPL/inv_mpu.c ****  *  If @e sensors does not contain a particular sensor, disregard the data
1689:BSP/MPU6050/eMPL/inv_mpu.c ****  *  returned to that pointer.
1690:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n @e sensors can contain a combination of the following flags:
1691:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_X_GYRO, INV_Y_GYRO, INV_Z_GYRO
1692:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_XYZ_GYRO
1693:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n INV_XYZ_ACCEL
1694:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n If the FIFO has no new data, @e sensors will be zero.
1695:BSP/MPU6050/eMPL/inv_mpu.c ****  *  \n If the FIFO is disabled, @e sensors will be zero and this function will
1696:BSP/MPU6050/eMPL/inv_mpu.c ****  *  return a non-zero error code.
1697:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[out] gyro        Gyro data in hardware units.
1698:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[out] accel       Accel data in hardware units.
1699:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[out] timestamp   Timestamp in milliseconds.
1700:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[out] sensors     Mask of sensors read from FIFO.
1701:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[out] more        Number of remaining packets.
1702:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
1703:BSP/MPU6050/eMPL/inv_mpu.c ****  */
1704:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_read_fifo(short *gyro, short *accel, unsigned long *timestamp,
1705:BSP/MPU6050/eMPL/inv_mpu.c ****         unsigned char *sensors, unsigned char *more)
