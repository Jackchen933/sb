1361:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1362:BSP/MPU6050/eMPL/inv_mpu.c ****     else
1363:BSP/MPU6050/eMPL/inv_mpu.c ****         rate[0] = st.chip_cfg.sample_rate;
1364:BSP/MPU6050/eMPL/inv_mpu.c ****     return 0;
1365:BSP/MPU6050/eMPL/inv_mpu.c **** }
1366:BSP/MPU6050/eMPL/inv_mpu.c **** 
1367:BSP/MPU6050/eMPL/inv_mpu.c **** /**
1368:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Set sampling rate.
1369:BSP/MPU6050/eMPL/inv_mpu.c ****  *  Sampling rate must be between 4Hz and 1kHz.
1370:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[in]  rate    Desired sampling rate (Hz).
1371:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
1372:BSP/MPU6050/eMPL/inv_mpu.c ****  */
1373:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_set_sample_rate(unsigned short rate)
1374:BSP/MPU6050/eMPL/inv_mpu.c **** {
1375:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char data;
1376:BSP/MPU6050/eMPL/inv_mpu.c **** 
1377:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!(st.chip_cfg.sensors))
1378:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1379:BSP/MPU6050/eMPL/inv_mpu.c **** 
1380:BSP/MPU6050/eMPL/inv_mpu.c ****     if (st.chip_cfg.dmp_on)
1381:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1382:BSP/MPU6050/eMPL/inv_mpu.c ****     else {
1383:BSP/MPU6050/eMPL/inv_mpu.c ****         if (st.chip_cfg.lp_accel_mode) {
1384:BSP/MPU6050/eMPL/inv_mpu.c ****             if (rate && (rate <= 40)) {
1385:BSP/MPU6050/eMPL/inv_mpu.c ****                 /* Just stay in low-power accel mode. */
1386:BSP/MPU6050/eMPL/inv_mpu.c ****                 mpu_lp_accel_mode(rate);
1387:BSP/MPU6050/eMPL/inv_mpu.c ****                 return 0;
1388:BSP/MPU6050/eMPL/inv_mpu.c ****             }
1389:BSP/MPU6050/eMPL/inv_mpu.c ****             /* Requested rate exceeds the allowed frequencies in LP accel mode,
1390:BSP/MPU6050/eMPL/inv_mpu.c ****              * switch back to full-power mode.
1391:BSP/MPU6050/eMPL/inv_mpu.c ****              */
1392:BSP/MPU6050/eMPL/inv_mpu.c ****             mpu_lp_accel_mode(0);
1393:BSP/MPU6050/eMPL/inv_mpu.c ****         }
1394:BSP/MPU6050/eMPL/inv_mpu.c ****         if (rate < 4)
1395:BSP/MPU6050/eMPL/inv_mpu.c ****             rate = 4;
1396:BSP/MPU6050/eMPL/inv_mpu.c ****         else if (rate > 1000)
1397:BSP/MPU6050/eMPL/inv_mpu.c ****             rate = 1000;
1398:BSP/MPU6050/eMPL/inv_mpu.c **** 
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc50WfpY.s 			page 26


1399:BSP/MPU6050/eMPL/inv_mpu.c ****         data = 1000 / rate - 1;
1400:BSP/MPU6050/eMPL/inv_mpu.c ****         if (i2c_write(st.hw->addr, st.reg->rate_div, 1, &data))
1401:BSP/MPU6050/eMPL/inv_mpu.c ****             return -1;
1402:BSP/MPU6050/eMPL/inv_mpu.c **** 
1403:BSP/MPU6050/eMPL/inv_mpu.c ****         st.chip_cfg.sample_rate = 1000 / (1 + data);
1404:BSP/MPU6050/eMPL/inv_mpu.c **** 
1405:BSP/MPU6050/eMPL/inv_mpu.c **** #ifdef AK89xx_SECONDARY
1406:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_compass_sample_rate(min(st.chip_cfg.compass_sample_rate, MAX_COMPASS_SAMPLE_RATE));
1407:BSP/MPU6050/eMPL/inv_mpu.c **** #endif
1408:BSP/MPU6050/eMPL/inv_mpu.c **** 
1409:BSP/MPU6050/eMPL/inv_mpu.c ****         /* Automatically set LPF to 1/2 sampling rate. */
1410:BSP/MPU6050/eMPL/inv_mpu.c ****         mpu_set_lpf(st.chip_cfg.sample_rate >> 1);
1411:BSP/MPU6050/eMPL/inv_mpu.c ****         return 0;
1412:BSP/MPU6050/eMPL/inv_mpu.c ****     }
1413:BSP/MPU6050/eMPL/inv_mpu.c **** }
1414:BSP/MPU6050/eMPL/inv_mpu.c **** 
