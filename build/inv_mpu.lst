1319:BSP/MPU6050/eMPL/inv_mpu.c **** /**
1320:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Set digital low pass filter.
1321:BSP/MPU6050/eMPL/inv_mpu.c ****  *  The following LPF settings are supported: 188, 98, 42, 20, 10, 5.
1322:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[in]  lpf Desired LPF setting.
1323:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
1324:BSP/MPU6050/eMPL/inv_mpu.c ****  */
1325:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_set_lpf(unsigned short lpf)
1326:BSP/MPU6050/eMPL/inv_mpu.c **** {
1327:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char data;
1328:BSP/MPU6050/eMPL/inv_mpu.c **** 
1329:BSP/MPU6050/eMPL/inv_mpu.c ****     if (!(st.chip_cfg.sensors))
1330:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1331:BSP/MPU6050/eMPL/inv_mpu.c **** 
1332:BSP/MPU6050/eMPL/inv_mpu.c ****     if (lpf >= 188)
1333:BSP/MPU6050/eMPL/inv_mpu.c ****         data = INV_FILTER_188HZ;
1334:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (lpf >= 98)
1335:BSP/MPU6050/eMPL/inv_mpu.c ****         data = INV_FILTER_98HZ;
1336:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (lpf >= 42)
1337:BSP/MPU6050/eMPL/inv_mpu.c ****         data = INV_FILTER_42HZ;
1338:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (lpf >= 20)
1339:BSP/MPU6050/eMPL/inv_mpu.c ****         data = INV_FILTER_20HZ;
1340:BSP/MPU6050/eMPL/inv_mpu.c ****     else if (lpf >= 10)
1341:BSP/MPU6050/eMPL/inv_mpu.c ****         data = INV_FILTER_10HZ;
ARM GAS  C:\Users\chen\AppData\Local\Temp\cc50WfpY.s 			page 25


1342:BSP/MPU6050/eMPL/inv_mpu.c ****     else
1343:BSP/MPU6050/eMPL/inv_mpu.c ****         data = INV_FILTER_5HZ;
1344:BSP/MPU6050/eMPL/inv_mpu.c **** 
1345:BSP/MPU6050/eMPL/inv_mpu.c ****     if (st.chip_cfg.lpf == data)
1346:BSP/MPU6050/eMPL/inv_mpu.c ****         return 0;
1347:BSP/MPU6050/eMPL/inv_mpu.c ****     if (i2c_write(st.hw->addr, st.reg->lpf, 1, &data))
1348:BSP/MPU6050/eMPL/inv_mpu.c ****         return -1;
1349:BSP/MPU6050/eMPL/inv_mpu.c ****     st.chip_cfg.lpf = data;
1350:BSP/MPU6050/eMPL/inv_mpu.c ****     return 0;
1351:BSP/MPU6050/eMPL/inv_mpu.c **** }
1352:BSP/MPU6050/eMPL/inv_mpu.c **** 
1353:BSP/MPU6050/eMPL/inv_mpu.c **** /**
1354:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @brief      Get sampling rate.
1355:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @param[out] rate    Current sampling rate (Hz).
1356:BSP/MPU6050/eMPL/inv_mpu.c ****  *  @return     0 if successful.
