1675:BSP/MPU6050/eMPL/inv_mpu.c **** int mpu_get_int_status(short *status)
1676:BSP/MPU6050/eMPL/inv_mpu.c **** {
1677:BSP/MPU6050/eMPL/inv_mpu.c ****     unsigned char tmp[2];
