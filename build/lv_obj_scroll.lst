 213:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****         return obj->spec_attr->scroll.x;
 214:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     }
 215:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c **** 
 216:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     /*With other base direction (LTR) scrolling to the right is normal so find the right most coord
 217:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     lv_coord_t child_res = LV_COORD_MIN;
 218:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     uint32_t i;
