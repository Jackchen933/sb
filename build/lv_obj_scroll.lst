 238:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     return LV_MAX(child_res, self_w);
 239:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c **** }
