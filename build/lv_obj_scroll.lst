 205:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c **** lv_coord_t lv_obj_get_scroll_right(lv_obj_t * obj)
 206:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c **** {
 207:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
 208:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c **** 
 209:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     /*With RTL base dir can't scroll to the object out on the right.
 210:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****      *So simply use the current scroll position as "right size"*/
 211:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     if(lv_obj_get_style_base_dir(obj, LV_PART_MAIN) == LV_BASE_DIR_RTL) {
