 220:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     for(i = 0; i < child_cnt; i++) {
 221:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****         lv_obj_t * child = obj->spec_attr->children[i];
 222:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****         if(lv_obj_has_flag_any(child,  LV_OBJ_FLAG_HIDDEN | LV_OBJ_FLAG_FLOATING)) continue;
 223:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****         child_res = LV_MAX(child_res, child->coords.x2);
 224:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     }
 225:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c **** 
 226:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     lv_coord_t pad_right = lv_obj_get_style_pad_right(obj, LV_PART_MAIN);
 227:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     lv_coord_t pad_left = lv_obj_get_style_pad_left(obj, LV_PART_MAIN);
 228:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     lv_coord_t border_width = lv_obj_get_style_border_width(obj, LV_PART_MAIN);
 229:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c **** 
 230:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     if(child_res != LV_COORD_MIN) {
 231:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****         child_res -= (obj->coords.x2 - pad_right - border_width);
 232:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     }
 233:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c **** 
 234:Middlewares/LVGL/GUI/lvgl/src/core/lv_obj_scroll.c ****     lv_coord_t self_w;
