 227:BSP/MPU6050/mpu6050.c ****     @param  NULL
 228:BSP/MPU6050/mpu6050.c **** 
 229:BSP/MPU6050/mpu6050.c ****     @return 0 if success
 230:BSP/MPU6050/mpu6050.c **** */
