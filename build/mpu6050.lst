 184:BSP/MPU6050/mpu6050.c **** /*
 185:BSP/MPU6050/mpu6050.c ****     @brief  设置MPU6050的采样率
 186:BSP/MPU6050/mpu6050.c **** 
 187:BSP/MPU6050/mpu6050.c ****     @param  rate: 4~1000 Hz
 188:BSP/MPU6050/mpu6050.c **** 
 189:BSP/MPU6050/mpu6050.c ****     @return 0 if success
 190:BSP/MPU6050/mpu6050.c **** */
 191:BSP/MPU6050/mpu6050.c **** /**************************************************************************/
 192:BSP/MPU6050/mpu6050.c **** u8 MPU_Set_Rate(u16 rate)
 193:BSP/MPU6050/mpu6050.c **** {
 194:BSP/MPU6050/mpu6050.c **** 	u8 data;
 195:BSP/MPU6050/mpu6050.c **** 	if(rate>1000)rate=1000;
 196:BSP/MPU6050/mpu6050.c **** 	if(rate<4)rate=4;
 197:BSP/MPU6050/mpu6050.c **** 	data=1000/rate-1;
 198:BSP/MPU6050/mpu6050.c **** 	data=MPU_Write_Byte(MPU_SAMPLE_RATE_REG,data);
 199:BSP/MPU6050/mpu6050.c ****  	return MPU_Set_LPF(rate/2);
 200:BSP/MPU6050/mpu6050.c **** }
 201:BSP/MPU6050/mpu6050.c **** 
 202:BSP/MPU6050/mpu6050.c **** /**************************************************************************/
 203:BSP/MPU6050/mpu6050.c **** /*
 204:BSP/MPU6050/mpu6050.c ****     @brief  获取MPU6050温度值
 205:BSP/MPU6050/mpu6050.c **** 
 206:BSP/MPU6050/mpu6050.c ****     @param  NULL
 207:BSP/MPU6050/mpu6050.c **** 
 208:BSP/MPU6050/mpu6050.c ****     @return temperature (short)
 209:BSP/MPU6050/mpu6050.c **** */
 210:BSP/MPU6050/mpu6050.c **** /**************************************************************************/
 211:BSP/MPU6050/mpu6050.c **** short MPU_Get_Temperature(void)
 212:BSP/MPU6050/mpu6050.c **** {
 213:BSP/MPU6050/mpu6050.c ****     u8 buf[2]; 
 214:BSP/MPU6050/mpu6050.c ****     short raw;
 215:BSP/MPU6050/mpu6050.c **** 		float temp;
 216:BSP/MPU6050/mpu6050.c **** 		MPU_Read_Len(MPU_ADDR,MPU_TEMP_OUTH_REG,2,buf); 
 217:BSP/MPU6050/mpu6050.c ****     raw=((u16)buf[0]<<8)|buf[1];  
 218:BSP/MPU6050/mpu6050.c ****     temp=36.53+((double)raw)/340;  
 219:BSP/MPU6050/mpu6050.c ****     return temp*100;;
 220:BSP/MPU6050/mpu6050.c **** }
 221:BSP/MPU6050/mpu6050.c **** 
 222:BSP/MPU6050/mpu6050.c **** 
 223:BSP/MPU6050/mpu6050.c **** /**************************************************************************/
