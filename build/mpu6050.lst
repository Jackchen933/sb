  81:BSP/MPU6050/mpu6050.c **** /**************************************************************************/
  82:BSP/MPU6050/mpu6050.c **** u8 MPU_Init(void)
  83:BSP/MPU6050/mpu6050.c **** { 
  84:BSP/MPU6050/mpu6050.c **** 	u8 res;
  85:BSP/MPU6050/mpu6050.c **** 	
  86:BSP/MPU6050/mpu6050.c **** 	MPU_Bus_Init();
  87:BSP/MPU6050/mpu6050.c **** 	
  88:BSP/MPU6050/mpu6050.c **** 	MPU_Write_Byte(MPU_PWR_MGMT1_REG,0X80);	//复位MPU6050
  89:BSP/MPU6050/mpu6050.c ****   delay_ms(100);
  90:BSP/MPU6050/mpu6050.c **** 	MPU_Write_Byte(MPU_PWR_MGMT1_REG,0X00);	//唤醒MPU6050 
  91:BSP/MPU6050/mpu6050.c **** 	MPU_Set_Gyro_Fsr(3);										//G传感器, 2000dps
  92:BSP/MPU6050/mpu6050.c **** 	MPU_Set_Accel_Fsr(2);										//A传感器, 8g
  93:BSP/MPU6050/mpu6050.c **** 	MPU_Set_Rate(50);												//采样率50Hz
  94:BSP/MPU6050/mpu6050.c **** 	MPU_Write_Byte(MPU_INT_EN_REG,0X00);		//关闭所有中断
  95:BSP/MPU6050/mpu6050.c **** 	MPU_Write_Byte(MPU_USER_CTRL_REG,0X00);	//IIC主模式关闭
  96:BSP/MPU6050/mpu6050.c **** 	MPU_Write_Byte(MPU_FIFO_EN_REG,0X00);		//dis FIFO
  97:BSP/MPU6050/mpu6050.c **** 	MPU_Write_Byte(MPU_INTBP_CFG_REG,0X80);	//INT active low
  98:BSP/MPU6050/mpu6050.c **** 	
  99:BSP/MPU6050/mpu6050.c **** 	res=MPU_Read_Byte(MPU_DEVICE_ID_REG);
 100:BSP/MPU6050/mpu6050.c **** 	if(res==MPU_ADDR)//ID
 101:BSP/MPU6050/mpu6050.c **** 	{
 102:BSP/MPU6050/mpu6050.c **** 		MPU_Write_Byte(MPU_PWR_MGMT1_REG,0X28);	//SET the internal 8MHz,sleep=0,cycle=1,TEMP_DIS=1//low p
 103:BSP/MPU6050/mpu6050.c **** 		MPU_Write_Byte(MPU_PWR_MGMT2_REG,0X87);	//enable accelerometer,disanable gyroscope,set the wake u
 104:BSP/MPU6050/mpu6050.c **** 		MPU_Set_Rate(50);												//采样率50Hz
 105:BSP/MPU6050/mpu6050.c ****  	}else return 1;
 106:BSP/MPU6050/mpu6050.c **** 	
 107:BSP/MPU6050/mpu6050.c **** 	MPU_Motion_Init();
 108:BSP/MPU6050/mpu6050.c **** 	MPU_INT_Pin_Init();
 109:BSP/MPU6050/mpu6050.c **** 	
 110:BSP/MPU6050/mpu6050.c **** 	
 111:BSP/MPU6050/mpu6050.c **** 	return 0;
 112:BSP/MPU6050/mpu6050.c **** }
 113:BSP/MPU6050/mpu6050.c **** 
 114:BSP/MPU6050/mpu6050.c **** void MPU_Sleep()
 115:BSP/MPU6050/mpu6050.c **** {
 116:BSP/MPU6050/mpu6050.c **** 	MPU_Write_Byte(MPU_PWR_MGMT1_REG,0x48);//sleep=1,cycle=0,temp_dis=1,internal 8MHz
 117:BSP/MPU6050/mpu6050.c **** }
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccMBFtEZ.s 			page 6


 118:BSP/MPU6050/mpu6050.c **** 
 119:BSP/MPU6050/mpu6050.c **** void MPU_Wakeup()
 120:BSP/MPU6050/mpu6050.c **** {
 121:BSP/MPU6050/mpu6050.c **** 	//low power modes
 122:BSP/MPU6050/mpu6050.c **** 	MPU_Write_Byte(MPU_PWR_MGMT1_REG,0x28);//sleep=0,cycle=1,temp_dis=1,internal 8MHz
 123:BSP/MPU6050/mpu6050.c **** }
 124:BSP/MPU6050/mpu6050.c **** 
 125:BSP/MPU6050/mpu6050.c **** uint8_t MPU_Read_Status()
 126:BSP/MPU6050/mpu6050.c **** {
