  44:BSP/MPU6050/mpu6050.c **** /*!
  45:BSP/MPU6050/mpu6050.c ****     @brief  initialize the motion function of MPU6050
  46:BSP/MPU6050/mpu6050.c **** 
  47:BSP/MPU6050/mpu6050.c ****     @param  NULL
  48:BSP/MPU6050/mpu6050.c **** */
  49:BSP/MPU6050/mpu6050.c **** /**************************************************************************/
  50:BSP/MPU6050/mpu6050.c **** void MPU_Motion_Init(void)			
  51:BSP/MPU6050/mpu6050.c **** {
  52:BSP/MPU6050/mpu6050.c ****     MPU_Write_Byte(MPU_MOTION_DET_REG,0x01);    //set the acceleration threshold is (LSB*2)mg
  53:BSP/MPU6050/mpu6050.c ****     MPU_Write_Byte(MPU_MOTION_DUR_REG,0x01);    //Acceleration detection time is ()ms 
  54:BSP/MPU6050/mpu6050.c ****     MPU_Write_Byte(MPU_INTBP_CFG_REG,0X90);     //INT Pin active low level, reset until 50us
  55:BSP/MPU6050/mpu6050.c ****     MPU_Write_Byte(MPU_INT_EN_REG,0x40);       	//enable INT
  56:BSP/MPU6050/mpu6050.c **** }
  57:BSP/MPU6050/mpu6050.c **** 
  58:BSP/MPU6050/mpu6050.c **** 
  59:BSP/MPU6050/mpu6050.c **** /**************************************************************************/
