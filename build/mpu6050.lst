 232:BSP/MPU6050/mpu6050.c **** u8 MPU_Get_Gyroscope(short *gx,short *gy,short *gz)
 233:BSP/MPU6050/mpu6050.c **** {
 234:BSP/MPU6050/mpu6050.c ****     u8 buf[6],res;  
 235:BSP/MPU6050/mpu6050.c **** 		res=MPU_Read_Len(MPU_ADDR,MPU_GYRO_XOUTH_REG,6,buf);
 236:BSP/MPU6050/mpu6050.c **** 		if(res==0)
 237:BSP/MPU6050/mpu6050.c **** 		{
 238:BSP/MPU6050/mpu6050.c **** 			*gx=((u16)buf[0]<<8)|buf[1];  
 239:BSP/MPU6050/mpu6050.c **** 			*gy=((u16)buf[2]<<8)|buf[3];  
 240:BSP/MPU6050/mpu6050.c **** 			*gz=((u16)buf[4]<<8)|buf[5];
 241:BSP/MPU6050/mpu6050.c **** 		} 	
 242:BSP/MPU6050/mpu6050.c ****     return res;;
 243:BSP/MPU6050/mpu6050.c **** }
