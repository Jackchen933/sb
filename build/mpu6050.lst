 256:BSP/MPU6050/mpu6050.c **** {
 257:BSP/MPU6050/mpu6050.c ****     u8 buf[6],res;  
 258:BSP/MPU6050/mpu6050.c **** 		res=MPU_Read_Len(MPU_ADDR,MPU_ACCEL_XOUTH_REG,6,buf);
 259:BSP/MPU6050/mpu6050.c **** 		if(res==0)
 260:BSP/MPU6050/mpu6050.c **** 		{
 261:BSP/MPU6050/mpu6050.c **** 			*ax=((u16)buf[0]<<8)|buf[1];  
 262:BSP/MPU6050/mpu6050.c **** 			*ay=((u16)buf[2]<<8)|buf[3];  
 263:BSP/MPU6050/mpu6050.c **** 			*az=((u16)buf[4]<<8)|buf[5];
 264:BSP/MPU6050/mpu6050.c **** 		} 	
 265:BSP/MPU6050/mpu6050.c ****     return res;;
 266:BSP/MPU6050/mpu6050.c **** }
