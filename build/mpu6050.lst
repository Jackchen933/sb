 169:BSP/MPU6050/mpu6050.c **** /**************************************************************************/
 170:BSP/MPU6050/mpu6050.c **** u8 MPU_Set_LPF(u16 lpf)
 171:BSP/MPU6050/mpu6050.c **** {
 172:BSP/MPU6050/mpu6050.c **** 	u8 data=0;
 173:BSP/MPU6050/mpu6050.c **** 	if(lpf>=188)data=1;
 174:BSP/MPU6050/mpu6050.c **** 	else if(lpf>=98)data=2;
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccMBFtEZ.s 			page 7


 175:BSP/MPU6050/mpu6050.c **** 	else if(lpf>=42)data=3;
 176:BSP/MPU6050/mpu6050.c **** 	else if(lpf>=20)data=4;
 177:BSP/MPU6050/mpu6050.c **** 	else if(lpf>=10)data=5;
 178:BSP/MPU6050/mpu6050.c **** 	else data=6; 
 179:BSP/MPU6050/mpu6050.c **** 	return MPU_Write_Byte(MPU_CFG_REG,data);
 180:BSP/MPU6050/mpu6050.c **** }
