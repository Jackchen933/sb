 120:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****             while(item) {
 121:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****                 next = (lv_lru_item_t *) item->next;
 122:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****                 cache->value_free(item->value);
 123:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****                 cache->key_free(item->key);
 124:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****                 cache->free_memory += item->value_length;
 125:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****                 lv_mem_free(item);
 126:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****                 item = next;
 127:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****             }
 128:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         }
 129:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         lv_mem_free(cache->items);
 130:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     }
 131:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c **** 
 132:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     if(cache->free_items) {
 133:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         item = cache->free_items;
 134:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         while(item) {
 135:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****             next = (lv_lru_item_t *) item->next;
 136:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****             lv_mem_free(item);
 137:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****             item = next;
 138:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         }
 139:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     }
 140:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c **** 
 141:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     // free the cache
