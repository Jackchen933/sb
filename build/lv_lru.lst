 150:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     test_for_missing_value();
 151:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     test_for_value_too_large();
 152:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c **** 
 153:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     // see if the key already exists
 154:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     uint32_t hash_index = lv_lru_hash(cache, key, key_length);
 155:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     size_t required = 0;
 156:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     lv_lru_item_t * item = NULL, *prev = NULL;
 157:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     item = cache->items[hash_index];
 158:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c **** 
 159:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     while(item && lv_lru_cmp_keys(item, key, key_length)) {
 160:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         prev = item;
 161:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         item = (lv_lru_item_t *) item->next;
 162:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     }
 163:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c **** 
 164:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     if(item) {
 165:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         // update the value and value_lengths
 166:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         required = (size_t)(value_length - item->value_length);
 167:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         cache->value_free(item->value);
 168:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         item->value = value;
 169:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         item->value_length = value_length;
 170:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c **** 
 171:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     }
 172:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     else {
 173:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         // insert a new item
 174:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         item = lv_lru_pop_or_create_item(cache);
 175:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         item->value = value;
 176:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         item->key = lv_mem_alloc(key_length);
