 186:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     }
 187:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     item->access_count = ++cache->access_count;
 188:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c **** 
 189:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     // remove as many items as necessary to free enough space
 190:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****     if(required > 0 && (size_t) required > cache->free_memory) {
 191:Middlewares/LVGL/GUI/lvgl/src/misc/lv_lru.c ****         while(cache->free_memory < (size_t) required)
