 206:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** int32_t lv_anim_path_linear(const lv_anim_t * a)
 207:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** {
 208:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     /*Calculate the current step*/
 209:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     int32_t step = lv_map(a->act_time, 0, a->time, 0, LV_ANIM_RESOLUTION);
 210:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 211:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     /*Get the new value which will be proportional to `step`
 212:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****      *and the `start` and `end` values*/
 213:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     int32_t new_value;
 214:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     new_value = step * (a->end_value - a->start_value);
 215:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     new_value = new_value >> LV_ANIM_RES_SHIFT;
 216:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     new_value += a->start_value;
 217:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
