 340:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** /**
 341:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****  * Periodically handle the animations.
 342:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****  * @param param unused
 343:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****  */
 344:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** static void anim_timer(lv_timer_t * param)
 345:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** {
 346:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     LV_UNUSED(param);
 347:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 348:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     uint32_t elaps = lv_tick_elaps(last_timer_run);
 349:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 350:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     /*Flip the run round*/
 351:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     anim_run_round = anim_run_round ? false : true;
 352:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 353:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     lv_anim_t * a = _lv_ll_get_head(&LV_GC_ROOT(_lv_anim_ll));
 354:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 355:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     while(a != NULL) {
 356:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         /*It can be set by `lv_anim_del()` typically in `end_cb`. If set then an animation delete
 357:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****          * happened in `anim_ready_handler` which could make this linked list reading corrupt
