 361:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 362:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         if(a->run_round != anim_run_round) {
 363:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****             a->run_round = anim_run_round; /*The list readying might be reset so need to know which
 364:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 365:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****             /*The animation will run now for the first time. Call `start_cb`*/
 366:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****             int32_t new_act_time = a->act_time + elaps;
 367:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****             if(!a->start_cb_called && a->act_time <= 0 && new_act_time >= 0) {
 368:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****                 if(a->early_apply == 0 && a->get_value_cb) {
