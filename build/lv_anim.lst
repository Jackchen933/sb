 117:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** uint32_t lv_anim_get_playtime(lv_anim_t * a)
 118:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** {
 119:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     uint32_t playtime = LV_ANIM_PLAYTIME_INFINITE;
 120:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 121:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     if(a->repeat_cnt == LV_ANIM_REPEAT_INFINITE)
 122:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         return playtime;
 123:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 124:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     playtime = a->time - a->act_time;
 125:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     if(a->playback_now == 0)
 126:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         playtime += a->playback_delay + a->playback_time;
 127:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 128:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     if(a->repeat_cnt <= 1)
 129:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         return playtime;
 130:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 131:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     playtime += (a->repeat_delay + a->time +
 132:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****                  a->playback_delay + a->playback_time) *
 133:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****                 (a->repeat_cnt - 1);
 134:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 135:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     return playtime;
 136:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** }
