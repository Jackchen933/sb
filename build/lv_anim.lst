 277:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** int32_t lv_anim_path_bounce(const lv_anim_t * a)
 278:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** {
 279:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     /*Calculate the current step*/
 280:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     int32_t t = lv_map(a->act_time, 0, a->time, 0, LV_BEZIER_VAL_MAX);
 281:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     int32_t diff = (a->end_value - a->start_value);
 282:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 283:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     /*3 bounces has 5 parts: 3 down and 2 up. One part is t / 5 long*/
 284:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 285:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     if(t < 408) {
 286:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         /*Go down*/
 287:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t = (t * 2500) >> LV_BEZIER_VAL_SHIFT; /*[0..1024] range*/
 288:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     }
 289:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     else if(t >= 408 && t < 614) {
 290:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         /*First bounce back*/
 291:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t -= 408;
 292:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t    = t * 5; /*to [0..1024] range*/
 293:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t    = LV_BEZIER_VAL_MAX - t;
 294:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         diff = diff / 20;
 295:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     }
 296:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     else if(t >= 614 && t < 819) {
 297:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         /*Fall back*/
 298:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t -= 614;
 299:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t    = t * 5; /*to [0..1024] range*/
 300:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         diff = diff / 20;
 301:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     }
 302:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     else if(t >= 819 && t < 921) {
 303:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         /*Second bounce back*/
 304:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t -= 819;
 305:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t    = t * 10; /*to [0..1024] range*/
 306:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t    = LV_BEZIER_VAL_MAX - t;
 307:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         diff = diff / 40;
 308:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     }
 309:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     else if(t >= 921 && t <= LV_BEZIER_VAL_MAX) {
 310:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         /*Fall back*/
 311:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t -= 921;
 312:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         t    = t * 10; /*to [0..1024] range*/
 313:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         diff = diff / 40;
 314:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     }
 315:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 316:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     if(t > LV_BEZIER_VAL_MAX) t = LV_BEZIER_VAL_MAX;
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccXbo4UB.s 			page 7


 317:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     if(t < 0) t = 0;
 318:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     int32_t step = lv_bezier3(t, LV_BEZIER_VAL_MAX, 800, 500, 0);
 319:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 320:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     int32_t new_value;
 321:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     new_value = step * diff;
 322:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     new_value = new_value >> LV_BEZIER_VAL_SHIFT;
 323:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     new_value = a->end_value - new_value;
 324:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 325:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     return new_value;
 326:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** }
