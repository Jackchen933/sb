 407:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** /**
 408:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****  * Called when an animation is ready to do the necessary thinks
 409:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****  * e.g. repeat, play back, delete etc.
 410:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****  * @param a pointer to an animation descriptor
 411:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****  */
 412:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** static void anim_ready_handler(lv_anim_t * a)
 413:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** {
 414:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     /*In the end of a forward anim decrement repeat cnt.*/
 415:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     if(a->playback_now == 0 && a->repeat_cnt > 0 && a->repeat_cnt != LV_ANIM_REPEAT_INFINITE) {
 416:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         a->repeat_cnt--;
 417:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     }
 418:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 419:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     /*Delete the animation if
 420:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****      * - no repeat left and no play back (simple one shot animation)
 421:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****      * - no repeat, play back is enabled and play back is ready*/
 422:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     if(a->repeat_cnt == 0 && (a->playback_time == 0 || a->playback_now == 1)) {
 423:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 424:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         /*Delete the animation from the list.
 425:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****          * This way the `ready_cb` will see the animations like it's animation is ready deleted*/
 426:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         _lv_ll_remove(&LV_GC_ROOT(_lv_anim_ll), a);
 427:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         /*Flag that the list has changed*/
 428:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         anim_mark_list_change();
 429:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c **** 
 430:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         /*Call the callback function at the end*/
ARM GAS  C:\Users\chen\AppData\Local\Temp\ccXbo4UB.s 			page 9


 431:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         if(a->ready_cb != NULL) a->ready_cb(a);
 432:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         lv_mem_free(a);
 433:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     }
 434:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     /*If the animation is not deleted then restart it*/
