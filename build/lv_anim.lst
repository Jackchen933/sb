 331:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         return a->end_value;
 332:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****     else
 333:Middlewares/LVGL/GUI/lvgl/src/misc/lv_anim.c ****         return a->start_value;
