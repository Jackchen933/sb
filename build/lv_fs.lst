 143:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****         uint16_t buffer_remaining_length = buffer_size - buffer_offset;
 144:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c **** 
