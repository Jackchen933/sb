 455:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c **** 
 456:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****     len--; /*Go before the trailing '\0'*/
 457:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c **** 
 458:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****     /*Ignore trailing '/' or '\'*/
 459:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****     while(path[len] == '/' || path[len] == '\\') {
 460:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****         path[len] = '\0';
 461:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****         if(len > 0)
 462:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****             len--;
 463:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****         else
 464:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****             return path;
 465:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****     }
 466:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c **** 
 467:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****     size_t i;
 468:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****     for(i = len; i > 0; i--) {
 469:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****         if(path[i] == '/' || path[i] == '\\') break;
 470:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****     }
 471:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c **** 
 472:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****     if(i > 0) path[i] = '\0';
 473:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c **** 
 474:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****     return path;
 475:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c **** }
