 145:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****         if(btr <= buffer_remaining_length) {
 146:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****             /*Data is in cache buffer, and buffer end not reached, no need to read from FS*/
 147:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****             lv_memcpy(buf, buffer + buffer_offset, btr);
 148:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****         }
 149:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****         else {
 150:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****             /*First part of data is in cache buffer, but we need to read rest of data from FS*/
 151:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c ****             lv_memcpy(buf, buffer + buffer_offset, buffer_remaining_length);
 152:Middlewares/LVGL/GUI/lvgl/src/misc/lv_fs.c **** 
