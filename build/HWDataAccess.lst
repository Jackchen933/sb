  30:User/Func/Src/HWDataAccess.c **** void HW_RTC_Get_TimeDate(HW_DateTimeTypeDef * nowdatetime)
  31:User/Func/Src/HWDataAccess.c **** {
  32:User/Func/Src/HWDataAccess.c **** 
  33:User/Func/Src/HWDataAccess.c **** 	#if HW_USE_RTC
  34:User/Func/Src/HWDataAccess.c **** 		if (nowdatetime != NULL)
  35:User/Func/Src/HWDataAccess.c **** 		{
  36:User/Func/Src/HWDataAccess.c ****             RTC_DateTypeDef nowdate;
  37:User/Func/Src/HWDataAccess.c ****             RTC_TimeTypeDef nowtime;
  38:User/Func/Src/HWDataAccess.c **** 			HAL_RTC_GetTime(&hrtc, &nowtime, RTC_FORMAT_BIN);
  39:User/Func/Src/HWDataAccess.c **** 			HAL_RTC_GetDate(&hrtc, &nowdate, RTC_FORMAT_BIN);
  40:User/Func/Src/HWDataAccess.c ****             nowdatetime->Year = nowdate.Year;
  41:User/Func/Src/HWDataAccess.c ****             nowdatetime->Month = nowdate.Month;
  42:User/Func/Src/HWDataAccess.c ****             nowdatetime->Date = nowdate.Date;
  43:User/Func/Src/HWDataAccess.c **** 			nowdatetime->WeekDay = weekday_calculate(nowdatetime->Year, nowdatetime->Month, nowdatetime->Dat
  44:User/Func/Src/HWDataAccess.c ****             nowdatetime->Hours = nowtime.Hours;
  45:User/Func/Src/HWDataAccess.c ****             nowdatetime->Minutes = nowtime.Minutes;
  46:User/Func/Src/HWDataAccess.c ****             nowdatetime->Seconds = nowtime.Seconds;
  47:User/Func/Src/HWDataAccess.c **** 		}
  48:User/Func/Src/HWDataAccess.c **** 	#else
  49:User/Func/Src/HWDataAccess.c **** 		nowdatetime->Year = 24;
  50:User/Func/Src/HWDataAccess.c **** 		nowdatetime->Month = 6;
  51:User/Func/Src/HWDataAccess.c **** 		nowdatetime->Date = 23;
  52:User/Func/Src/HWDataAccess.c **** 		nowdatetime->WeekDay = 7;
  53:User/Func/Src/HWDataAccess.c **** 		nowdatetime->Hours = 11;
  54:User/Func/Src/HWDataAccess.c **** 		nowdatetime->Minutes = 59;
  55:User/Func/Src/HWDataAccess.c **** 		nowdatetime->Seconds = 55;
  56:User/Func/Src/HWDataAccess.c **** 	#endif
  57:User/Func/Src/HWDataAccess.c **** }
  58:User/Func/Src/HWDataAccess.c **** 
  59:User/Func/Src/HWDataAccess.c **** 
