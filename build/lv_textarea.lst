 407:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_textarea.c **** 
 408:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_textarea.c ****     /*The text area needs to have it's final size to see if the cursor is out of the area or not*/
