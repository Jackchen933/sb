 394:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_textarea.c **** 
 395:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_textarea.c ****     if(pos < 0) pos = len + pos;
 396:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_textarea.c **** 
