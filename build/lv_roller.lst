 202:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** /**
 203:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * Get the id of the selected option
 204:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @param roller pointer to a roller object
 205:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @return id of the selected option (0 ... number of option - 1);
 206:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  */
