  90:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** /**
  91:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * Set the options on a roller
  92:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @param roller pointer to roller object
  93:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @param options a string with '\n' separated options. E.g. "One\nTwo\nThree"
  94:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @param mode `LV_ROLLER_MODE_NORMAL` or `LV_ROLLER_MODE_INFINITE`
  95:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  */
  96:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** void lv_roller_set_options(lv_obj_t * obj, const char * options, lv_roller_mode_t mode)
  97:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** {
  98:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
  99:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     LV_ASSERT_NULL(options);
 100:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 101:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     lv_roller_t * roller = (lv_roller_t *)obj;
 102:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     lv_obj_t * label = get_label(obj);
 103:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 104:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     roller->sel_opt_id     = 0;
 105:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     roller->sel_opt_id_ori = 0;
 106:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 107:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     /*Count the '\n'-s to determine the number of options*/
 108:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     roller->option_cnt = 0;
 109:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     uint32_t cnt;
 110:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     for(cnt = 0; options[cnt] != '\0'; cnt++) {
 111:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         if(options[cnt] == '\n') roller->option_cnt++;
 112:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     }
 113:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     roller->option_cnt++; /*Last option has no `\n`*/
 114:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 115:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     if(mode == LV_ROLLER_MODE_NORMAL) {
 116:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         roller->mode = LV_ROLLER_MODE_NORMAL;
 117:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         lv_label_set_text(label, options);
 118:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     }
 119:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     else {
 120:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         roller->mode = LV_ROLLER_MODE_INFINITE;
 121:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 122:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         size_t opt_len = strlen(options) + 1; /*+1 to add '\n' after option lists*/
 123:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         char * opt_extra = lv_mem_buf_get(opt_len * LV_ROLLER_INF_PAGES);
 124:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         uint8_t i;
 125:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         for(i = 0; i < LV_ROLLER_INF_PAGES; i++) {
 126:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****             strcpy(&opt_extra[opt_len * i], options);
 127:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****             opt_extra[opt_len * (i + 1) - 1] = '\n';
 128:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         }
 129:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         opt_extra[opt_len * LV_ROLLER_INF_PAGES - 1] = '\0';
 130:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         lv_label_set_text(label, opt_extra);
 131:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         lv_mem_buf_release(opt_extra);
 132:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 133:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         roller->sel_opt_id     = ((LV_ROLLER_INF_PAGES / 2) + 0) * roller->option_cnt;
 134:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 135:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         roller->option_cnt = roller->option_cnt * LV_ROLLER_INF_PAGES;
 136:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         inf_normalize(obj);
 137:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     }
 138:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 139:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     roller->sel_opt_id_ori = roller->sel_opt_id;
 140:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 141:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     /*If the selected text has larger font the label needs some extra draw padding to draw it.*/
 142:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     lv_obj_refresh_ext_draw_size(label);
 143:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 144:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** }
