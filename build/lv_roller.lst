 146:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** /**
 147:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * Set the selected option
 148:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @param roller pointer to a roller object
 149:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @param sel_opt id of the selected option (0 ... number of option - 1);
 150:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @param anim_en LV_ANIM_ON: set with animation; LV_ANOM_OFF set immediately
 151:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  */
 152:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** void lv_roller_set_selected(lv_obj_t * obj, uint16_t sel_opt, lv_anim_enable_t anim)
 153:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** {
 154:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
 155:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 156:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     /*Set the value even if it's the same as the current value because
 157:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****      *if moving to the next option with an animation which was just deleted in the PRESS Call the a
 158:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****      *nothing will continue the animation.*/
 159:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 160:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     lv_roller_t * roller = (lv_roller_t *)obj;
 161:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 162:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     /*In infinite mode interpret the new ID relative to the currently visible "page"*/
 163:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     if(roller->mode == LV_ROLLER_MODE_INFINITE) {
 164:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         int32_t sel_opt_signed = sel_opt;
 165:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         uint16_t page = roller->sel_opt_id / LV_ROLLER_INF_PAGES;
 166:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 167:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         /*`sel_opt` should be less than the number of options set by the user.
 168:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****          *If it's more then probably it's a reference from not the first page
 169:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****          *so normalize `sel_opt`*/
 170:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         if(page != 0) {
 171:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****             sel_opt_signed -= page * LV_ROLLER_INF_PAGES;
 172:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         }
 173:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 174:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****         sel_opt = page * LV_ROLLER_INF_PAGES + sel_opt_signed;
 175:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     }
 176:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 177:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     roller->sel_opt_id     = sel_opt < roller->option_cnt ? sel_opt : roller->option_cnt - 1;
 178:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     roller->sel_opt_id_ori = roller->sel_opt_id;
 179:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 180:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     refr_position(obj, anim);
 181:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** }
 182:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 183:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** /**
 184:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * Set the height to show the given number of rows (options)
 185:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @param roller pointer to a roller object
 186:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * @param row_cnt number of desired visible rows
 187:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  */
 188:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** void lv_roller_set_visible_row_count(lv_obj_t * obj, uint8_t row_cnt)
 189:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** {
 190:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
 191:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 192:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     const lv_font_t * font = lv_obj_get_style_text_font(obj, LV_PART_MAIN);
 193:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     lv_coord_t line_space = lv_obj_get_style_text_line_space(obj, LV_PART_MAIN);
 194:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     lv_coord_t border_width = lv_obj_get_style_border_width(obj, LV_PART_MAIN);
 195:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****     lv_obj_set_height(obj, (lv_font_get_line_height(font) + line_space) * row_cnt + 2 * border_widt
 196:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** }
 197:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
 198:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** /*=====================
 199:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  * Getter functions
 200:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c ****  *====================*/
 201:Middlewares/LVGL/GUI/lvgl/src/widgets/lv_roller.c **** 
