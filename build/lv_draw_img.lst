 394:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****     /**
 395:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      * The floating point math for conversion is:
 396:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      *  valueto = valuefrom * ( (2^bitsto - 1) / (float)(2^bitsfrom - 1) )
 397:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      * The faster integer math for conversion is:
 398:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      *  valueto = ( valuefrom * multiplier + adder ) >> divisor
 399:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      *   multiplier = FLOOR( ( (2^bitsto - 1) << divisor ) / (float)(2^bitsfrom - 1) )
 400:Middlewares/LVGL/GUI/lvgl/src/draw/../misc/lv_color.h ****      *
